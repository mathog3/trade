// ============================================================================
// NOWICK CONFLUENCE PRO v2 — Brad.fx Multi-Pair
// Améliorations vs v1 :
//   + Order Block (zone institutionnelle = dernier canal opposé avant impulse)
//   + Pinbar / Big Bounce (signal direct sans retest)
//   + EMA 21/50 comme zone de confluence
//   + SL basé sur la structure (swing low/high) plutôt que simple ATR
//   + Paramètres assouplis → plus de trades
//   + Mémoire FVG et OB plus longue (lookback historique)
// ============================================================================

//@version=6
indicator("Nowick Confluence PRO v2", overlay=true,
          max_bars_back=500, max_labels_count=500, max_lines_count=500,
          max_boxes_count=400)

// ============================================================================
// INPUTS
// ============================================================================

g1 = "── Signal ──"
wick_pct     = input.float(20.0, "Mèche max nowick (% corps)",   minval=1,    maxval=100, step=1,    group=g1,
               tooltip="20% = plus de nowicks détectés. Baisse pour plus de qualité, monte pour plus de quantité.")
min_body_atr = input.float(0.25, "Corps min (× ATR)",             minval=0.05, maxval=2,   step=0.05, group=g1)
atr_len      = input.int(14,     "ATR length",                    minval=5,                           group=g1)
use_pinbar   = input.bool(true,  "Activer Pinbar (gros bounce)",  group=g1,
               tooltip="Grande mèche de rejet = signal même sans nowick parfait. Capture les gros bounces.")
pin_wick_pct = input.float(55.0, "Mèche min pinbar (% range)",   minval=20,   maxval=90,  step=5,    group=g1,
               tooltip="55% = la mèche fait au moins 55% du range total (high-low) de la bougie.")

g_direct = "── Bounce Direct ──"
use_direct   = input.bool(true,  "Signal immédiat pinbar + zone", group=g_direct,
               tooltip="OFF = attend le retest. ON = pinbar À un niveau = signal immédiat (gros bounces).")

g2 = "── Retest ──"
retest_bars  = input.int(25,   "Fenêtre retest (barres)",         minval=1, maxval=100,   group=g2)
retest_tol   = input.float(0.5,"Tolérance sweep (× ATR)",         minval=0, maxval=2,     step=0.1, group=g2)
req_dir      = input.bool(true, "Bougie de retest dans le bon sens", group=g2)

gc = "── Confluence ──"
conf_and     = input.bool(false, "Toutes confluences obligatoires (strict)", group=gc,
               tooltip="OFF = FVG OU OB OU EMA (recommandé). ON = tout simultanément (très rare).")

g3 = "── FVG ──"
use_fvg      = input.bool(true,  "Activer FVG",                   group=g3)
fvg_bars     = input.int(100,    "Mémoire FVG (barres)",          minval=10, maxval=500,  group=g3,
               tooltip="FVG gardés 100 barres (lookback historique plus long que v1).")
fvg_min_atr  = input.float(0.15, "Taille min FVG (× ATR)",       minval=0.05, maxval=5,  step=0.05, group=g3,
               tooltip="0.15 = FVGs plus petits acceptés. Monte pour ne garder que les gros.")
show_fvg     = input.bool(true,  "Afficher boîtes FVG",           group=g3)
fvg_max_show = input.int(3,      "Max FVG affichés simultanément", minval=1, maxval=10,             group=g3,
               tooltip="Limite le nombre de boîtes FVG visibles. 3 = seulement les 3 plus récents.")

g_ob = "── Order Block ──"
use_ob       = input.bool(true,  "Activer Order Block",            group=g_ob,
               tooltip="OB = dernier canal opposé avant un mouvement impulsif. Zone institutionnelle clé.")
ob_impulse   = input.float(1.8,  "Impulse OB (× ATR)",            minval=0.5, maxval=10,  step=0.1, group=g_ob)
ob_bars      = input.int(150,    "Mémoire OB (barres)",           minval=20,  maxval=500,           group=g_ob)
show_ob      = input.bool(true,  "Afficher Order Blocks",          group=g_ob)
ob_max_show  = input.int(2,      "Max OB affichés simultanément",  minval=1, maxval=6,              group=g_ob,
               tooltip="Limite le nombre de boîtes OB visibles. 2 = seulement les 2 plus récents.")

g_ema = "── EMA Bounce ──"
use_ema_conf = input.bool(true,  "Activer confluence EMA bounce",  group=g_ema,
               tooltip="Bougie qui touche l'EMA 21 ou 50 et rebondit = confluence.")
ema1_len     = input.int(21,     "EMA 1",                         minval=5,                          group=g_ema)
ema2_len     = input.int(50,     "EMA 2",                         minval=10,                         group=g_ema)
ema_tol_atr  = input.float(0.3,  "Tolérance EMA (× ATR)",        minval=0.05, maxval=2, step=0.05,  group=g_ema)

g5 = "── Trend ──"
use_sma      = input.bool(true, "Filtre SMA 200",                  group=g5)
sma_len      = input.int(200,   "SMA length",                      minval=20,                        group=g5)

g6 = "── Session ──"
use_sess     = input.bool(true, "Session UTC 7-17 (Londres+NY)",   group=g6)

g7 = "── SL / TP ──"
sl_lookback  = input.int(8,     "SL structure lookback (barres)",  minval=3,  maxval=30,             group=g7,
               tooltip="SL placé sous le swing low des X dernières barres (structure) + buffer ATR.")
sl_buf       = input.float(0.3, "SL buffer (× ATR)",               minval=0,  maxval=3,  step=0.1,  group=g7)
tp1_rr       = input.float(2.0, "TP1 RR",                          minval=0.5, maxval=10, step=0.5, group=g7)
tp2_rr       = input.float(3.5, "TP2 RR",                          minval=0.5, maxval=15, step=0.5, group=g7)

// ============================================================================
// CALCULS DE BASE
// ============================================================================

atr    = ta.atr(atr_len)
sma200 = ta.sma(close, sma_len)
ema1   = ta.ema(close, ema1_len)
ema2   = ta.ema(close, ema2_len)

body    = math.abs(close - open)
up_wick = high - math.max(open, close)
dn_wick = math.min(open, close) - low
rng     = high - low
big_bod = body >= atr * min_body_atr

sma_ok_bull = not use_sma or close > sma200
sma_ok_bear = not use_sma or close < sma200
sess_ok     = not use_sess or (hour(time, "UTC") >= 7 and hour(time, "UTC") < 17)

// ── NOWICK ──────────────────────────────────────────────────────────────────
thresh  = body * (wick_pct / 100.0)
bull_nw = close > open and dn_wick <= thresh and big_bod
bear_nw = close < open and up_wick <= thresh and big_bod

// ── PINBAR (gros bounce) ─────────────────────────────────────────────────────
// Bull pinbar = hammer : grande mèche basse, close dans la moitié haute du range
bull_pin = use_pinbar and rng > atr * 0.3 and
           dn_wick >= rng * (pin_wick_pct / 100.0) and
           close >= low + rng * 0.35

// Bear pinbar = shooting star : grande mèche haute, close dans la moitié basse
bear_pin = use_pinbar and rng > atr * 0.3 and
           up_wick >= rng * (pin_wick_pct / 100.0) and
           close <= high - rng * 0.35

valid_bull = (bull_nw or bull_pin) and sma_ok_bull
valid_bear = (bear_nw or bear_pin) and sma_ok_bear

// ============================================================================
// FVG (Fair Value Gap)
// ============================================================================

bull_fvg_top = high[2]
bull_fvg_bot = low[0]
bull_fvg_ok  = low[0] > high[2] and (low[0] - high[2]) >= atr * fvg_min_atr

bear_fvg_top = high[0]
bear_fvg_bot = low[2]
bear_fvg_ok  = high[0] < low[2] and (low[2] - high[0]) >= atr * fvg_min_atr

var float[] bfvg_top = array.new_float(0)
var float[] bfvg_bot = array.new_float(0)
var int[]   bfvg_age = array.new_int(0)

var float[] sfvg_top = array.new_float(0)
var float[] sfvg_bot = array.new_float(0)
var int[]   sfvg_age = array.new_int(0)

if bull_fvg_ok
    array.unshift(bfvg_top, bull_fvg_top)
    array.unshift(bfvg_bot, bull_fvg_bot)
    array.unshift(bfvg_age, bar_index)

if bear_fvg_ok
    array.unshift(sfvg_top, bear_fvg_top)
    array.unshift(sfvg_bot, bear_fvg_bot)
    array.unshift(sfvg_age, bar_index)

fi = 0
while fi < array.size(bfvg_age)
    if bar_index - array.get(bfvg_age, fi) > fvg_bars or low <= array.get(bfvg_bot, fi)
        array.remove(bfvg_top, fi)
        array.remove(bfvg_bot, fi)
        array.remove(bfvg_age, fi)
    else
        fi += 1

fj = 0
while fj < array.size(sfvg_age)
    if bar_index - array.get(sfvg_age, fj) > fvg_bars or high >= array.get(sfvg_top, fj)
        array.remove(sfvg_top, fj)
        array.remove(sfvg_bot, fj)
        array.remove(sfvg_age, fj)
    else
        fj += 1

price_in_bull_fvg = false
price_in_bear_fvg = false

if use_fvg and array.size(bfvg_top) > 0
    for k = 0 to array.size(bfvg_top) - 1
        if low <= array.get(bfvg_top, k) and close >= array.get(bfvg_bot, k)
            price_in_bull_fvg := true

if use_fvg and array.size(sfvg_top) > 0
    for k = 0 to array.size(sfvg_top) - 1
        if high >= array.get(sfvg_bot, k) and close <= array.get(sfvg_top, k)
            price_in_bear_fvg := true

if show_fvg and bull_fvg_ok and array.size(bfvg_top) <= fvg_max_show
    box.new(bar_index - 2, bull_fvg_bot, bar_index + 30, bull_fvg_top,
            border_color=color.new(color.teal, 60),
            bgcolor=color.new(color.teal, 85), border_width=1)

if show_fvg and bear_fvg_ok and array.size(sfvg_top) <= fvg_max_show
    box.new(bar_index - 2, bear_fvg_bot, bar_index + 30, bear_fvg_top,
            border_color=color.new(color.orange, 60),
            bgcolor=color.new(color.orange, 85), border_width=1)

// ============================================================================
// ORDER BLOCK
// ============================================================================
// Bull OB = dernier canal baissier AVANT une impulse haussière forte
//   → Quand le prix revient dans ce canal = zone d'achat institutionnelle
// Bear OB = dernier canal haussier AVANT une impulse baissière forte
//   → Quand le prix revient dans ce canal = zone de vente institutionnelle

big_bull_imp = close > open and body >= atr * ob_impulse
big_bear_imp = close < open and body >= atr * ob_impulse

var float[] bull_ob_top = array.new_float(0)
var float[] bull_ob_bot = array.new_float(0)
var int[]   bull_ob_age = array.new_int(0)
var int[]   bull_ob_bar = array.new_int(0)  // bar_index du canal OB lui-même

var float[] bear_ob_top = array.new_float(0)
var float[] bear_ob_bot = array.new_float(0)
var int[]   bear_ob_age = array.new_int(0)
var int[]   bear_ob_bar = array.new_int(0)

bull_ob_new = false
bear_ob_new = false

if big_bull_imp
    for offset = 1 to 8
        if close[offset] < open[offset]
            ob_t = math.max(open[offset], close[offset])
            ob_b = math.min(open[offset], close[offset])
            array.unshift(bull_ob_top, ob_t)
            array.unshift(bull_ob_bot, ob_b)
            array.unshift(bull_ob_age, bar_index)
            array.unshift(bull_ob_bar, bar_index - offset)
            bull_ob_new := true
            break

if big_bear_imp
    for offset = 1 to 8
        if close[offset] > open[offset]
            ob_t = math.max(open[offset], close[offset])
            ob_b = math.min(open[offset], close[offset])
            array.unshift(bear_ob_top, ob_t)
            array.unshift(bear_ob_bot, ob_b)
            array.unshift(bear_ob_age, bar_index)
            array.unshift(bear_ob_bar, bar_index - offset)
            bear_ob_new := true
            break

oi = 0
while oi < array.size(bull_ob_age)
    if bar_index - array.get(bull_ob_age, oi) > ob_bars or low < array.get(bull_ob_bot, oi) - atr
        array.remove(bull_ob_top, oi)
        array.remove(bull_ob_bot, oi)
        array.remove(bull_ob_age, oi)
        array.remove(bull_ob_bar, oi)
    else
        oi += 1

oj = 0
while oj < array.size(bear_ob_age)
    if bar_index - array.get(bear_ob_age, oj) > ob_bars or high > array.get(bear_ob_top, oj) + atr
        array.remove(bear_ob_top, oj)
        array.remove(bear_ob_bot, oj)
        array.remove(bear_ob_age, oj)
        array.remove(bear_ob_bar, oj)
    else
        oj += 1

price_in_bull_ob = false
price_in_bear_ob = false

if use_ob and array.size(bull_ob_top) > 0
    for k = 0 to array.size(bull_ob_top) - 1
        if (bar_index - array.get(bull_ob_age, k)) >= 2 and
           low <= array.get(bull_ob_top, k) and close >= array.get(bull_ob_bot, k)
            price_in_bull_ob := true

if use_ob and array.size(bear_ob_top) > 0
    for k = 0 to array.size(bear_ob_top) - 1
        if (bar_index - array.get(bear_ob_age, k)) >= 2 and
           high >= array.get(bear_ob_bot, k) and close <= array.get(bear_ob_top, k)
            price_in_bear_ob := true

if show_ob and bull_ob_new and array.size(bull_ob_bar) > 0 and array.size(bull_ob_top) <= ob_max_show
    box.new(array.get(bull_ob_bar, 0), array.get(bull_ob_bot, 0),
            bar_index + 60, array.get(bull_ob_top, 0),
            border_color=color.new(color.blue, 40),
            bgcolor=color.new(color.blue, 88), border_width=1)

if show_ob and bear_ob_new and array.size(bear_ob_bar) > 0 and array.size(bear_ob_top) <= ob_max_show
    box.new(array.get(bear_ob_bar, 0), array.get(bear_ob_bot, 0),
            bar_index + 60, array.get(bear_ob_top, 0),
            border_color=color.new(color.purple, 40),
            bgcolor=color.new(color.purple, 88), border_width=1)

// ============================================================================
// EMA BOUNCE CONFLUENCE
// ============================================================================
// Bougie qui touche l'EMA et rebondit dans la bonne direction

touch_bull_ema1 = low <= ema1 + atr * ema_tol_atr and close > ema1 and close > open
touch_bull_ema2 = low <= ema2 + atr * ema_tol_atr and close > ema2 and close > open
near_ema_bull   = use_ema_conf and (touch_bull_ema1 or touch_bull_ema2)

touch_bear_ema1 = high >= ema1 - atr * ema_tol_atr and close < ema1 and close < open
touch_bear_ema2 = high >= ema2 - atr * ema_tol_atr and close < ema2 and close < open
near_ema_bear   = use_ema_conf and (touch_bear_ema1 or touch_bear_ema2)

// ============================================================================
// CONFLUENCE CHECK
// ============================================================================

bull_conf_fvg = price_in_bull_fvg
bull_conf_ob  = price_in_bull_ob
bull_conf_ema = near_ema_bull

bear_conf_fvg = price_in_bear_fvg
bear_conf_ob  = price_in_bear_ob
bear_conf_ema = near_ema_bear

bull_confluence = conf_and
                  ? (bull_conf_fvg and bull_conf_ob and bull_conf_ema)
                  : (bull_conf_fvg or bull_conf_ob or bull_conf_ema)

bear_confluence = conf_and
                  ? (bear_conf_fvg and bear_conf_ob and bear_conf_ema)
                  : (bear_conf_fvg or bear_conf_ob or bear_conf_ema)

// ============================================================================
// STOCKAGE NIVEAU + RETEST
// ============================================================================

var float nw_buy_lo = na
var int   nw_buy_b  = na
var float nw_sel_hi = na
var int   nw_sel_b  = na

if valid_bull
    nw_buy_lo := low
    nw_buy_b  := bar_index
if valid_bear
    nw_sel_hi := high
    nw_sel_b  := bar_index

age_buy  = na(nw_buy_b)  ? na : bar_index - nw_buy_b
age_sell = na(nw_sel_b)  ? na : bar_index - nw_sel_b

if not na(age_buy)  and age_buy  > retest_bars
    nw_buy_lo := na
    nw_buy_b  := na
if not na(age_sell) and age_sell > retest_bars
    nw_sel_hi := na
    nw_sel_b  := na

if not na(nw_buy_lo) and close < nw_buy_lo - atr * 0.3
    nw_buy_lo := na
    nw_buy_b  := na
if not na(nw_sel_hi) and close > nw_sel_hi + atr * 0.3
    nw_sel_hi := na
    nw_sel_b  := na

tol         = atr * retest_tol
dir_ok_buy  = not req_dir or close > open
dir_ok_sell = not req_dir or close < open

retest_buy  = not na(nw_buy_lo) and age_buy  >= 1 and age_buy  <= retest_bars and
              low  <= nw_buy_lo + tol and close >= nw_buy_lo - tol * 0.5 and dir_ok_buy

retest_sell = not na(nw_sel_hi) and age_sell >= 1 and age_sell <= retest_bars and
              high >= nw_sel_hi - tol and close <= nw_sel_hi + tol * 0.5 and dir_ok_sell

// ============================================================================
// SIGNAUX FINAUX
// ============================================================================
// Signal type A : retest du niveau nowick/pinbar + confluence
// Signal type B : pinbar DIRECTEMENT à un niveau (gros bounce immédiat)

sig_buy_retest  = retest_buy  and bull_confluence and sess_ok
sig_sell_retest = retest_sell and bear_confluence and sess_ok

sig_buy_direct  = use_direct and bull_pin and bull_confluence and sess_ok and sma_ok_bull
sig_sell_direct = use_direct and bear_pin and bear_confluence and sess_ok and sma_ok_bear

buy_sig  = sig_buy_retest  or sig_buy_direct
sell_sig = sig_sell_retest or sig_sell_direct

// Consommer le niveau après signal retest
if sig_buy_retest
    nw_buy_lo := na
    nw_buy_b  := na
if sig_sell_retest
    nw_sel_hi := na
    nw_sel_b  := na

// ============================================================================
// SL / TP — Structure-based
// ============================================================================
// SL = swing low/high des sl_lookback dernières barres + buffer ATR
// Plus robuste qu'un simple offset ATR : on place le SL sous la structure réelle

struct_sl_buy  = ta.lowest(low,  sl_lookback)
struct_sl_sell = ta.highest(high, sl_lookback)

buy_sl   = buy_sig  ? struct_sl_buy  - atr * sl_buf : na
sell_sl  = sell_sig ? struct_sl_sell + atr * sl_buf : na

buy_risk = not na(buy_sl)  ? close - buy_sl  : na
sel_risk = not na(sell_sl) ? sell_sl - close : na

buy_tp1  = not na(buy_risk) ? close + buy_risk * tp1_rr : na
buy_tp2  = not na(buy_risk) ? close + buy_risk * tp2_rr : na
sell_tp1 = not na(sel_risk) ? close - sel_risk * tp1_rr : na
sell_tp2 = not na(sel_risk) ? close - sel_risk * tp2_rr : na

// ============================================================================
// LABELS
// ============================================================================

if buy_sig
    type_str  = sig_buy_direct and not sig_buy_retest ? " ★" : ""
    conf_str  = (bull_conf_fvg ? "FVG " : "") + (bull_conf_ob ? "OB " : "") + (bull_conf_ema ? "EMA" : "")
    label.new(bar_index, low - atr * 0.8,
              "▲ BUY" + type_str + " [" + conf_str + "]\n" +
              "Entry  " + str.tostring(close,   format.mintick) + "\n" +
              "TP1    " + str.tostring(buy_tp1, format.mintick) + "\n" +
              "TP2    " + str.tostring(buy_tp2, format.mintick) + "\n" +
              "SL     " + str.tostring(buy_sl,  format.mintick),
              yloc=yloc.price, color=color.new(color.green, 0),
              textcolor=color.white, style=label.style_label_up, size=size.normal)
    line.new(bar_index, buy_tp1, bar_index + 40, buy_tp1, color=color.new(color.lime,  10), width=2, style=line.style_dashed)
    line.new(bar_index, buy_tp2, bar_index + 40, buy_tp2, color=color.new(color.teal,  10), width=1, style=line.style_dashed)
    line.new(bar_index, close,   bar_index + 40, close,   color=color.new(color.white, 40), width=1, style=line.style_dotted)
    line.new(bar_index, buy_sl,  bar_index + 40, buy_sl,  color=color.new(color.red,   10), width=2, style=line.style_dashed)

if sell_sig
    type_str  = sig_sell_direct and not sig_sell_retest ? " ★" : ""
    conf_str  = (bear_conf_fvg ? "FVG " : "") + (bear_conf_ob ? "OB " : "") + (bear_conf_ema ? "EMA" : "")
    label.new(bar_index, high + atr * 0.8,
              "▼ SELL" + type_str + " [" + conf_str + "]\n" +
              "Entry  " + str.tostring(close,    format.mintick) + "\n" +
              "TP1    " + str.tostring(sell_tp1, format.mintick) + "\n" +
              "TP2    " + str.tostring(sell_tp2, format.mintick) + "\n" +
              "SL     " + str.tostring(sell_sl,  format.mintick),
              yloc=yloc.price, color=color.new(color.red, 0),
              textcolor=color.white, style=label.style_label_down, size=size.normal)
    line.new(bar_index, sell_tp1, bar_index + 40, sell_tp1, color=color.new(color.lime,  10), width=2, style=line.style_dashed)
    line.new(bar_index, sell_tp2, bar_index + 40, sell_tp2, color=color.new(color.teal,  10), width=1, style=line.style_dashed)
    line.new(bar_index, close,    bar_index + 40, close,    color=color.new(color.white, 40), width=1, style=line.style_dotted)
    line.new(bar_index, sell_sl,  bar_index + 40, sell_sl,  color=color.new(color.red,   10), width=2, style=line.style_dashed)

// ============================================================================
// VISUELS
// ============================================================================

// Nowicks (triangles verts/rouges) et Pinbars (cercles cyan/orange)
plotshape(valid_bull and bull_nw,  "NW Bull",  shape.triangleup,   location.belowbar, color.new(color.lime,   20), size=size.tiny)
plotshape(valid_bear and bear_nw,  "NW Bear",  shape.triangledown, location.abovebar, color.new(color.red,    20), size=size.tiny)
plotshape(valid_bull and bull_pin and not bull_nw, "Pin Bull", shape.circle, location.belowbar, color.new(color.aqua,   30), size=size.tiny)
plotshape(valid_bear and bear_pin and not bear_nw, "Pin Bear", shape.circle, location.abovebar, color.new(color.orange, 30), size=size.tiny)

// EMAs et SMA
plot(ema1,                  "EMA 21", color.new(color.aqua,   50), 1)
plot(ema2,                  "EMA 50", color.new(color.purple, 50), 1)
plot(use_sma ? sma200 : na, "SMA 200",                       color.new(color.yellow, 30), 2)

// ============================================================================
// TABLE INFO
// ============================================================================

var table info = table.new(position.top_right, 2, 10,
     bgcolor=color.new(color.black, 75),
     border_color=color.new(color.gray, 50), border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "NW PRO v2",   text_color=color.white,  text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.cell(info, 1, 0, syminfo.ticker, text_color=color.yellow, text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)

    table.cell(info, 0, 1, "Session",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, sess_ok ? "✓ Active" : "✗ Fermée",
               text_color=sess_ok ? color.lime : color.red, text_size=size.small)

    table.cell(info, 0, 2, "SMA 200",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, close > sma200 ? "▲ BULL" : "▼ BEAR",
               text_color=close > sma200 ? color.lime : color.red, text_size=size.small)

    table.cell(info, 0, 3, "FVG actifs",   text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(array.size(bfvg_top)) + "↑ / " + str.tostring(array.size(sfvg_top)) + "↓",
               text_color=color.teal, text_size=size.small)

    table.cell(info, 0, 4, "OB actifs",    text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(array.size(bull_ob_top)) + "↑ / " + str.tostring(array.size(bear_ob_top)) + "↓",
               text_color=color.blue, text_size=size.small)

    table.cell(info, 0, 5, "NW pending",   text_color=color.white, text_size=size.small)
    nw_str = not na(nw_buy_lo) ? "BUY " + str.tostring(age_buy) + "b" :
             not na(nw_sel_hi) ? "SELL " + str.tostring(age_sell) + "b" : "—"
    table.cell(info, 1, 5, nw_str,
               text_color=not na(nw_buy_lo) ? color.lime : not na(nw_sel_hi) ? color.red : color.gray,
               text_size=size.small)

    table.cell(info, 0, 6, "In FVG",       text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6,
               price_in_bull_fvg ? "✓ BULL" : price_in_bear_fvg ? "✓ BEAR" : "—",
               text_color=price_in_bull_fvg ? color.lime : price_in_bear_fvg ? color.orange : color.gray,
               text_size=size.small)

    table.cell(info, 0, 7, "In OB",        text_color=color.white, text_size=size.small)
    table.cell(info, 1, 7,
               price_in_bull_ob ? "✓ BULL" : price_in_bear_ob ? "✓ BEAR" : "—",
               text_color=price_in_bull_ob ? color.blue : price_in_bear_ob ? color.purple : color.gray,
               text_size=size.small)

    table.cell(info, 0, 8, "EMA bounce",   text_color=color.white, text_size=size.small)
    table.cell(info, 1, 8,
               near_ema_bull ? "✓ BULL" : near_ema_bear ? "✓ BEAR" : "—",
               text_color=near_ema_bull ? color.aqua : near_ema_bear ? color.orange : color.gray,
               text_size=size.small)

    table.cell(info, 0, 9, "EMA21/50",     text_color=color.white, text_size=size.small)
    table.cell(info, 1, 9,
               str.tostring(ema1, format.mintick) + " / " + str.tostring(ema2, format.mintick),
               text_color=color.gray, text_size=size.small)

// ============================================================================
// ALERTCONDITIONS
// ============================================================================
alertcondition(buy_sig,             "NW PRO v2 BUY",  "{{ticker}} BUY ★ | Entry {{close}} | TF {{interval}}")
alertcondition(sell_sig,            "NW PRO v2 SELL", "{{ticker}} SELL ★ | Entry {{close}} | TF {{interval}}")
alertcondition(buy_sig or sell_sig, "NW PRO v2 ANY",  "{{ticker}} SIGNAL | Entry {{close}} | TF {{interval}}")
