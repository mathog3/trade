// ============================================================================
// NOWICK CONFLUENCE PRO — Brad.fx Multi-Pair
// v1.0 — Nowick + Gap Fill + Rejection Zone confluence
//
// LOGIQUE :
//   Un nowick seul = niveau potentiel.
//   Un nowick + confluence (gap fill OU rejection zone) = signal de qualité.
//   → C'est exactement les trades que tu prends sur le screenshot.
//
// DÉPLOIEMENT MULTI-PAIR :
//   Coller cet indicateur sur : AUDUSD, EURUSD, GBPUSD, USDJPY, GBPJPY
//   Créer une alerte TradingView "Nowick CONFLUENCE BUY/SELL" sur chaque chart.
//   = 5x plus de setups sans baisser la qualité.
//
// FILTRES ACTIFS (dans l'ordre de sélection) :
//   1. Nowick valide (corps >= 0.4 ATR, mèche <= 12% du corps)
//   2. SMA200 alignment (trend de fond)
//   3. Session Londres+NY (7h-17h UTC)
//   4. Retest du niveau nowick (le niveau tient = momentum confirmé)
//   5. CONFLUENCE : FVG fill OU Rejection zone OU les deux
// ============================================================================

//@version=6
indicator("Nowick Confluence PRO", overlay=true,
          max_bars_back=500, max_labels_count=500, max_lines_count=500,
          max_boxes_count=200)

// ============================================================================
// INPUTS
// ============================================================================

g1 = "── Nowick ──"
wick_pct     = input.float(12.0, "Mèche max (% corps)",  minval=1, maxval=50, step=1, group=g1,
               tooltip="12% = wick ≤ 12% du corps. Plus strict = moins de trades mais meilleure qualité.")
min_body_atr = input.float(0.4,  "Corps min (× ATR)",    minval=0.1, maxval=2, step=0.1, group=g1)
atr_len      = input.int(14,     "ATR length",            minval=5, group=g1)

g2 = "── Retest ──"
retest_bars  = input.int(15,   "Fenêtre retest (barres)", minval=1, maxval=50, group=g2)
retest_tol   = input.float(0.3,"Tolérance sweep (× ATR)", minval=0, maxval=1,  step=0.05, group=g2)
req_dir      = input.bool(true, "Bougie de retest dans le bon sens ★", group=g2,
               tooltip="BUY = bougie verte sur le retest. SELL = bougie rouge. Filtre WR principal.")

gc = "── Mode Confluence ──"
conf_and     = input.bool(false, "FVG ET Rejection (strict)", group=gc,
               tooltip="OFF = FVG OU Rejection (recommandé, plus de signaux). ON = les deux obligatoires en même temps (très rare).")

g3 = "── Gap Fill (FVG) ──"
use_fvg      = input.bool(true,  "Activer confluence Gap Fill", group=g3,
               tooltip="Fair Value Gap : zone laissée entre 3 bougies consécutives. Le marché a tendance à revenir la combler.")
fvg_bars     = input.int(50,     "Mémoire FVG (barres max)", minval=10, maxval=200, group=g3,
               tooltip="FVG plus vieux que cette limite sont supprimés.")
fvg_min_atr  = input.float(0.3,  "Taille min FVG (× ATR)",   minval=0.1, maxval=5, step=0.1, group=g3,
               tooltip="0.3 ATR = ~6 pips AUDUSD M15. Baisse si trop peu de FVG.")
show_fvg     = input.bool(true,  "Afficher boîtes FVG", group=g3)

g4 = "── Rejection Zone ──"
use_rej_zone = input.bool(true,  "Activer confluence Rejection Zone", group=g4,
               tooltip="Zone où le prix a fait un gros mouvement impulsif. Le bas/haut de l'impulse = zone clé.")
rej_impulse  = input.float(1.5,  "Impulse min pour créer zone (× ATR)", minval=0.5, maxval=10, step=0.1, group=g4,
               tooltip="1.5× ATR = bougie impulsive. Baisse si trop peu de zones.")
rej_zone_bars= input.int(100,    "Mémoire zones (barres max)", minval=20, maxval=500, group=g4)
show_rej     = input.bool(true,  "Afficher Rejection Zones", group=g4)

g5 = "── Trend ──"
use_sma      = input.bool(true, "Filtre SMA 200", group=g5)
sma_len      = input.int(200,   "SMA length", minval=20, group=g5)

g6 = "── Session ──"
use_sess     = input.bool(true, "Session UTC 7-17 (Londres+NY)", group=g6)

g7 = "── SL / TP ──"
sl_buf       = input.float(0.5, "SL buffer (× ATR)", minval=0, maxval=3, step=0.1, group=g7)
tp1_rr       = input.float(2.0, "TP1 RR",            minval=0.5, maxval=10, step=0.5, group=g7)
tp2_rr       = input.float(3.0, "TP2 RR",            minval=0.5, maxval=15, step=0.5, group=g7)

// ============================================================================
// CALCULS DE BASE
// ============================================================================

atr    = ta.atr(atr_len)
sma200 = ta.sma(close, sma_len)

body    = math.abs(close - open)
up_wick = high - math.max(open, close)
dn_wick = math.min(open, close) - low
thresh  = body * (wick_pct / 100.0)
big_bod = body >= atr * min_body_atr

// ── NOWICK DETECTION ─────────────────────────────────────────────────────────
// Bull nowick : bougie verte, quasi zéro mèche basse → le low est un niveau fort
bull_nw_raw = close > open and dn_wick <= thresh and big_bod
// Bear nowick : bougie rouge, quasi zéro mèche haute → le high est un niveau fort
bear_nw_raw = close < open and up_wick <= thresh and big_bod

// ── FILTRES SIMPLES ───────────────────────────────────────────────────────────
sma_ok_bull = not use_sma or close > sma200
sma_ok_bear = not use_sma or close < sma200
sess_ok     = not use_sess or (hour(time, "UTC") >= 7 and hour(time, "UTC") < 17)

valid_bull_nw = bull_nw_raw and sma_ok_bull
valid_bear_nw = bear_nw_raw and sma_ok_bear

// ============================================================================
// GAP FILL / FAIR VALUE GAP (FVG)
// ============================================================================
// Pattern 3 bougies :
//   Bullish FVG : high[2] < low[0]  → gap haussier entre bougie-2 et bougie-0
//   Bearish FVG : low[2]  > high[0] → gap baissier entre bougie-2 et bougie-0
// Ces zones agissent comme des aimants : le prix revient les combler.
// Un nowick qui retest exactement dans un FVG = confluence forte.

// Détection des FVG (bougie du milieu crée le gap)
bull_fvg_top = high[2]  // haut du gap haussier
bull_fvg_bot = low[0]   // bas du gap haussier
bull_fvg_ok  = low[0] > high[2] and (low[0] - high[2]) >= atr * fvg_min_atr

bear_fvg_top = high[0]  // haut du gap baissier
bear_fvg_bot = low[2]   // bas du gap baissier
bear_fvg_ok  = high[0] < low[2] and (low[2] - high[0]) >= atr * fvg_min_atr

// Stockage des FVG actifs (on garde jusqu'à 10 FVG en mémoire)
// Bull FVG = zone à remplir par le bas (prix descend jusqu'au FVG → BUY)
// Bear FVG = zone à remplir par le haut (prix monte jusqu'au FVG → SELL)
var float[] bfvg_top = array.new_float(0)
var float[] bfvg_bot = array.new_float(0)
var int[]   bfvg_age = array.new_int(0)

var float[] sfvg_top = array.new_float(0)
var float[] sfvg_bot = array.new_float(0)
var int[]   sfvg_age = array.new_int(0)

// Ajout nouveau FVG
if bull_fvg_ok
    array.unshift(bfvg_top, bull_fvg_top)
    array.unshift(bfvg_bot, bull_fvg_bot)
    array.unshift(bfvg_age, bar_index)

if bear_fvg_ok
    array.unshift(sfvg_top, bear_fvg_top)
    array.unshift(sfvg_bot, bear_fvg_bot)
    array.unshift(sfvg_age, bar_index)

// Nettoyage FVG expirés ou déjà comblés
i = 0
while i < array.size(bfvg_age)
    age = bar_index - array.get(bfvg_age, i)
    bot = array.get(bfvg_bot, i)
    // FVG comblé si le prix est descendu sous le bas du gap, ou trop vieux
    if age > fvg_bars or low <= bot
        array.remove(bfvg_top, i)
        array.remove(bfvg_bot, i)
        array.remove(bfvg_age, i)
    else
        i += 1

j = 0
while j < array.size(sfvg_age)
    age = bar_index - array.get(sfvg_age, j)
    top = array.get(sfvg_top, j)
    if age > fvg_bars or high >= top
        array.remove(sfvg_top, j)
        array.remove(sfvg_bot, j)
        array.remove(sfvg_age, j)
    else
        j += 1

// Test confluence : le prix actuel est dans un FVG
price_in_bull_fvg = false
price_in_bear_fvg = false

if array.size(bfvg_top) > 0
    for k = 0 to array.size(bfvg_top) - 1
        if low <= array.get(bfvg_top, k) and close >= array.get(bfvg_bot, k)
            price_in_bull_fvg := true

if array.size(sfvg_top) > 0
    for k = 0 to array.size(sfvg_top) - 1
        if high >= array.get(sfvg_bot, k) and close <= array.get(sfvg_top, k)
            price_in_bear_fvg := true

// Affichage FVG (boîtes)
if show_fvg and bull_fvg_ok
    box.new(bar_index - 2, bull_fvg_bot, bar_index + 20, bull_fvg_top,
            border_color=color.new(color.teal, 60),
            bgcolor=color.new(color.teal, 85),
            border_width=1)

if show_fvg and bear_fvg_ok
    box.new(bar_index - 2, bear_fvg_bot, bar_index + 20, bear_fvg_top,
            border_color=color.new(color.orange, 60),
            bgcolor=color.new(color.orange, 85),
            border_width=1)

// ============================================================================
// REJECTION ZONE
// ============================================================================
// Une bougie impulsive (corps >= rej_impulse × ATR) crée une zone de rejet.
// La zone = corps de la bougie impulsive.
// Quand le prix revient tester cette zone = confluence forte.
//
// Exemples dans ton screenshot :
//   - Les grandes bougies rouges créent des zones de résistance (base en haut)
//   - Les grandes bougies vertes créent des zones de support (base en bas)

impulse_up   = close > open and body >= atr * rej_impulse  // grande bougie haussière
impulse_down = close < open and body >= atr * rej_impulse  // grande bougie baissière

// Stockage zones de rejet
// Bull rejection = base d'une bougie impulsive haussière → zone de support
// Bear rejection = base d'une bougie impulsive baissière → zone de résistance
var float[] brej_top = array.new_float(0)
var float[] brej_bot = array.new_float(0)
var int[]   brej_age = array.new_int(0)

var float[] srej_top = array.new_float(0)
var float[] srej_bot = array.new_float(0)
var int[]   srej_age = array.new_int(0)

if impulse_up
    // Zone = bas du corps de la bougie haussière impulsive
    array.unshift(brej_top, open + (body * 0.3))  // 30% du corps = zone
    array.unshift(brej_bot, open)
    array.unshift(brej_age, bar_index)

if impulse_down
    // Zone = haut du corps de la bougie baissière impulsive
    array.unshift(srej_top, open)
    array.unshift(srej_bot, open - (body * 0.3))
    array.unshift(srej_age, bar_index)

// Nettoyage zones expirées
ii = 0
while ii < array.size(brej_age)
    age = bar_index - array.get(brej_age, ii)
    bot = array.get(brej_bot, ii)
    if age > rej_zone_bars or close < bot - atr  // invalidée si cassée proprement
        array.remove(brej_top, ii)
        array.remove(brej_bot, ii)
        array.remove(brej_age, ii)
    else
        ii += 1

jj = 0
while jj < array.size(srej_age)
    age = bar_index - array.get(srej_age, jj)
    top = array.get(srej_top, jj)
    if age > rej_zone_bars or close > top + atr
        array.remove(srej_top, jj)
        array.remove(srej_bot, jj)
        array.remove(srej_age, jj)
    else
        jj += 1

// Test confluence : le prix est dans une rejection zone
price_in_bull_rej = false
price_in_bear_rej = false

if array.size(brej_top) > 0
    for k = 0 to array.size(brej_top) - 1
        if (bar_index - array.get(brej_age, k)) >= 3 and low <= array.get(brej_top, k) and close >= array.get(brej_bot, k)
            price_in_bull_rej := true

if array.size(srej_top) > 0
    for k = 0 to array.size(srej_top) - 1
        if (bar_index - array.get(srej_age, k)) >= 3 and high >= array.get(srej_bot, k) and close <= array.get(srej_top, k)
            price_in_bear_rej := true

// Affichage Rejection Zones
if show_rej and impulse_up
    box.new(bar_index, open, bar_index + 30, open + (body * 0.3),
            border_color=color.new(color.green, 50),
            bgcolor=color.new(color.green, 88),
            border_width=1)

if show_rej and impulse_down
    box.new(bar_index, open - (body * 0.3), bar_index + 30, open,
            border_color=color.new(color.red, 50),
            bgcolor=color.new(color.red, 88),
            border_width=1)

// ============================================================================
// STOCKAGE NIVEAU NOWICK (retest logic)
// ============================================================================

var float nw_buy_lo = na
var int   nw_buy_b  = na
var float nw_sel_hi = na
var int   nw_sel_b  = na

if valid_bull_nw
    nw_buy_lo := low
    nw_buy_b  := bar_index
if valid_bear_nw
    nw_sel_hi := high
    nw_sel_b  := bar_index

age_buy  = na(nw_buy_b)  ? na : bar_index - nw_buy_b
age_sell = na(nw_sel_b)  ? na : bar_index - nw_sel_b

// Expiration
if not na(age_buy)  and age_buy  > retest_bars
    nw_buy_lo := na
    nw_buy_b  := na
if not na(age_sell) and age_sell > retest_bars
    nw_sel_hi := na
    nw_sel_b  := na

// Invalidation (close casse le niveau)
if not na(nw_buy_lo) and close < nw_buy_lo - atr * 0.1
    nw_buy_lo := na
    nw_buy_b  := na
if not na(nw_sel_hi) and close > nw_sel_hi + atr * 0.1
    nw_sel_hi := na
    nw_sel_b  := na

// ============================================================================
// RETEST DETECTION
// ============================================================================

tol = atr * retest_tol

dir_ok_buy  = not req_dir or close > open
dir_ok_sell = not req_dir or close < open

retest_buy  = not na(nw_buy_lo) and age_buy  >= 1 and age_buy  <= retest_bars and
              low  <= nw_buy_lo + tol and close >= nw_buy_lo and dir_ok_buy

retest_sell = not na(nw_sel_hi) and age_sell >= 1 and age_sell <= retest_bars and
              high >= nw_sel_hi - tol and close <= nw_sel_hi and dir_ok_sell

// ============================================================================
// CONFLUENCE CHECK
// ============================================================================
// conf_and = false (défaut) → FVG OU Rejection = signal  (recommandé)
// conf_and = true           → FVG ET Rejection obligatoires (très strict)

bull_confluence = conf_and
                  ? ((not use_fvg or price_in_bull_fvg) and (not use_rej_zone or price_in_bull_rej))
                  : (price_in_bull_fvg or price_in_bull_rej)

bear_confluence = conf_and
                  ? ((not use_fvg or price_in_bear_fvg) and (not use_rej_zone or price_in_bear_rej))
                  : (price_in_bear_fvg or price_in_bear_rej)

// ── SIGNAUX FINAUX ────────────────────────────────────────────────────────────
buy_sig  = retest_buy  and bull_confluence and sess_ok
sell_sig = retest_sell and bear_confluence and sess_ok

// Consommer le niveau après signal
if buy_sig
    nw_buy_lo := na
    nw_buy_b  := na
if sell_sig
    nw_sel_hi := na
    nw_sel_b  := na

// ============================================================================
// SL / TP
// ============================================================================

buy_sl   = buy_sig  ? math.min(nw_buy_lo[1], low) - atr * sl_buf : na
sell_sl  = sell_sig ? math.max(nw_sel_hi[1], high) + atr * sl_buf : na
buy_risk = not na(buy_sl)  ? close - buy_sl  : na
sel_risk = not na(sell_sl) ? sell_sl - close : na
buy_tp1  = not na(buy_risk) ? close + buy_risk * tp1_rr : na
buy_tp2  = not na(buy_risk) ? close + buy_risk * tp2_rr : na
sell_tp1 = not na(sel_risk) ? close - sel_risk * tp1_rr : na
sell_tp2 = not na(sel_risk) ? close - sel_risk * tp2_rr : na

// ============================================================================
// LABELS
// ============================================================================

if buy_sig
    conf_str = (price_in_bull_fvg ? "FVG" : "") +
               (price_in_bull_fvg and price_in_bull_rej ? " + " : "") +
               (price_in_bull_rej ? "REJ" : "")
    label.new(bar_index, low - atr * 0.8,
              "▲ BUY [" + conf_str + "]\n" +
              "Entry  " + str.tostring(close,    format.mintick) + "\n" +
              "TP1    " + str.tostring(buy_tp1,  format.mintick) + "\n" +
              "TP2    " + str.tostring(buy_tp2,  format.mintick) + "\n" +
              "SL     " + str.tostring(buy_sl,   format.mintick),
              yloc=yloc.price,
              color=color.new(color.green, 0),
              textcolor=color.white,
              style=label.style_label_up,
              size=size.normal)
    line.new(bar_index, buy_tp1, bar_index + 40, buy_tp1, color=color.new(color.lime,  10), width=2, style=line.style_dashed)
    line.new(bar_index, buy_tp2, bar_index + 40, buy_tp2, color=color.new(color.teal,  10), width=1, style=line.style_dashed)
    line.new(bar_index, close,   bar_index + 40, close,   color=color.new(color.white, 40), width=1, style=line.style_dotted)
    line.new(bar_index, buy_sl,  bar_index + 40, buy_sl,  color=color.new(color.red,   10), width=2, style=line.style_dashed)

if sell_sig
    conf_str = (price_in_bear_fvg ? "FVG" : "") +
               (price_in_bear_fvg and price_in_bear_rej ? " + " : "") +
               (price_in_bear_rej ? "REJ" : "")
    label.new(bar_index, high + atr * 0.8,
              "▼ SELL [" + conf_str + "]\n" +
              "Entry  " + str.tostring(close,    format.mintick) + "\n" +
              "TP1    " + str.tostring(sell_tp1, format.mintick) + "\n" +
              "TP2    " + str.tostring(sell_tp2, format.mintick) + "\n" +
              "SL     " + str.tostring(sell_sl,  format.mintick),
              yloc=yloc.price,
              color=color.new(color.red, 0),
              textcolor=color.white,
              style=label.style_label_down,
              size=size.normal)
    line.new(bar_index, sell_tp1, bar_index + 40, sell_tp1, color=color.new(color.lime,  10), width=2, style=line.style_dashed)
    line.new(bar_index, sell_tp2, bar_index + 40, sell_tp2, color=color.new(color.teal,  10), width=1, style=line.style_dashed)
    line.new(bar_index, close,    bar_index + 40, close,    color=color.new(color.white, 40), width=1, style=line.style_dotted)
    line.new(bar_index, sell_sl,  bar_index + 40, sell_sl,  color=color.new(color.red,   10), width=2, style=line.style_dashed)

// ============================================================================
// VISUELS BASE
// ============================================================================

// Nowicks détectés (petits triangles)
plotshape(valid_bull_nw, "Bull NW", shape.triangleup,   location.belowbar, color.new(color.lime,  30), size=size.tiny)
plotshape(valid_bear_nw, "Bear NW", shape.triangledown, location.abovebar, color.new(color.red,   30), size=size.tiny)

// SMA200
plot(use_sma ? sma200 : na, "SMA 200", color.new(color.yellow, 30), 2)

// ============================================================================
// TABLE INFO
// ============================================================================

var table info = table.new(position.top_right, 2, 9,
     bgcolor=color.new(color.black, 75),
     border_color=color.new(color.gray, 50), border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "NW Confluence",   text_color=color.white,  text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.cell(info, 1, 0, syminfo.ticker,     text_color=color.yellow, text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)

    sess_color = sess_ok     ? color.lime : color.red
    sma_color  = (close > sma200) ? color.lime : color.red
    fvg_b_str  = str.tostring(array.size(bfvg_top)) + " bull / " + str.tostring(array.size(sfvg_top)) + " bear"
    rej_b_str  = str.tostring(array.size(brej_top)) + " bull / " + str.tostring(array.size(srej_top)) + " bear"
    nw_str     = not na(nw_buy_lo) ? "BUY " + str.tostring(age_buy) + "b" :
                 not na(nw_sel_hi) ? "SELL " + str.tostring(age_sell) + "b" : "—"

    table.cell(info, 0, 1, "Session",    text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, sess_ok ? "✓ Active" : "✗ Fermée", text_color=sess_color, text_size=size.small)

    table.cell(info, 0, 2, "SMA 200",    text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, close > sma200 ? "▲ BULL" : "▼ BEAR", text_color=sma_color, text_size=size.small)

    table.cell(info, 0, 3, "FVG actifs", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, fvg_b_str,   text_color=color.aqua,  text_size=size.small)

    table.cell(info, 0, 4, "Rej Zones",  text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, rej_b_str,   text_color=color.aqua,  text_size=size.small)

    table.cell(info, 0, 5, "NW pending", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, nw_str,
               text_color=not na(nw_buy_lo) ? color.lime : not na(nw_sel_hi) ? color.red : color.gray,
               text_size=size.small)

    table.cell(info, 0, 6, "In Bull FVG", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, price_in_bull_fvg ? "✓ OUI" : "—",
               text_color=price_in_bull_fvg ? color.lime : color.gray, text_size=size.small)

    table.cell(info, 0, 7, "In Bear FVG", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 7, price_in_bear_fvg ? "✓ OUI" : "—",
               text_color=price_in_bear_fvg ? color.orange : color.gray, text_size=size.small)

    table.cell(info, 0, 8, "In Rej Zone", text_color=color.white, text_size=size.small)
    rej_state = price_in_bull_rej ? "✓ BULL" : price_in_bear_rej ? "✓ BEAR" : "—"
    rej_col   = price_in_bull_rej ? color.lime : price_in_bear_rej ? color.red : color.gray
    table.cell(info, 1, 8, rej_state, text_color=rej_col, text_size=size.small)

// ============================================================================
// ALERTCONDITIONS — Créer une alerte sur chaque paire dans TradingView
// ============================================================================
alertcondition(buy_sig,           "Nowick CONFLUENCE BUY",  "{{ticker}} — Nowick CONFLUENCE BUY | Entry: {{close}} | Confluence: FVG/REJ | TF: {{interval}}")
alertcondition(sell_sig,          "Nowick CONFLUENCE SELL", "{{ticker}} — Nowick CONFLUENCE SELL | Entry: {{close}} | Confluence: FVG/REJ | TF: {{interval}}")
alertcondition(buy_sig or sell_sig, "Nowick CONFLUENCE ANY","{{ticker}} — Nowick CONFLUENCE {{strategy.order.action}} | Entry: {{close}} | TF: {{interval}}")
