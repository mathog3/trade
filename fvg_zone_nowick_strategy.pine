// ============================================================================
// FVG · Zone Clé · Nowick — Strategy v1 | Brad.fx
// Pine Script v5 — Backtesting TradingView
//
// Conversion de l'indicateur v1.1 en strategy :
//  - Même logique exacte (FVG + Zone + Nowick 3/4)
//  - strategy.entry() à la fermeture de la barre signal
//  - strategy.exit() : limit = TP FVG, stop = SL avec buffer ATR
//  - Split TP optionnel (50% TP1, 50% TP2 avec breakeven)
//  - Table de performance intégrée
// ============================================================================

//@version=5
strategy("FVG · Zone · Nowick — Strategy v1",
         overlay              = true,
         max_labels_count     = 200,
         max_lines_count      = 200,
         max_boxes_count      = 50,
         initial_capital      = 10000,
         default_qty_type     = strategy.percent_of_equity,
         default_qty_value    = 1,
         commission_type      = strategy.commission.percent,
         commission_value     = 0.003,
         slippage             = 1,
         calc_on_every_tick   = false,
         pyramiding           = 0)

// ============================================================================
// INPUTS — identiques à l'indicateur
// ============================================================================
g_nw = "── Nowick ──"
wick_pct     = input.float(8.0,  "Mèche max (% corps)",             group=g_nw, minval=1.0, maxval=25.0, step=1.0)
min_body_atr = input.float(0.5,  "Corps min (× ATR)",               group=g_nw, minval=0.1, maxval=3.0,  step=0.1)
atr_len      = input.int(14,     "ATR length",                      group=g_nw, minval=5, maxval=50)

g_fvg = "── FVG / Impulsion ──"
impulse_mult = input.float(1.2,  "Impulsion min (× ATR)",           group=g_fvg, minval=0.3, maxval=5.0, step=0.1)
fvg_max_age  = input.int(60,     "FVG max age (barres)",            group=g_fvg, minval=5, maxval=300)
show_fvg     = input.bool(true,  "Afficher zones FVG",              group=g_fvg)

g_zone = "── Zone Clé ──"
use_consol   = input.bool(true,  "Consolidation = zone OK",         group=g_zone)
consol_range = input.float(1.5,  "Range consol max (× ATR)",        group=g_zone, minval=0.2, maxval=5.0, step=0.1)
use_mt       = input.bool(false, "Multi-touch actif (optionnel)",   group=g_zone)
zone_lb      = input.int(80,     "  └ Lookback (barres)",           group=g_zone, minval=10, maxval=300)
zone_min_t   = input.int(2,      "  └ Touches min",                 group=g_zone, minval=1, maxval=6)
zone_tol     = input.float(0.4,  "  └ Tolérance (× ATR)",          group=g_zone, minval=0.05, maxval=2.0, step=0.05)

g_entry = "── Entrée / RR ──"
entry_win    = input.int(8,      "Fenêtre retest NW (barres)",      group=g_entry, minval=1, maxval=30)
sl_buf       = input.float(0.2,  "SL buffer (× ATR)",               group=g_entry, minval=0.0, maxval=2.0, step=0.05)
rr_min       = input.float(2.0,  "RR minimum requis",               group=g_entry, minval=1.0, maxval=10.0, step=0.5)
use_fvg_tp   = input.bool(true,  "TP = bord du FVG",                group=g_entry)
tp_fixed_rr  = input.float(2.0,  "RR fixe (si FVG TP désactivé)",  group=g_entry, minval=1.0, step=0.5)

g_filt = "── Filtres ──"
use_sma    = input.bool(true,  "SMA 200 (tendance)",  group=g_filt)
use_sess   = input.bool(true,  "Session UTC",          group=g_filt)
sess_start = input.int(6,      "Début UTC",            group=g_filt, minval=0, maxval=23)
sess_end   = input.int(20,     "Fin UTC",              group=g_filt, minval=1, maxval=23)
cooldown_b = input.int(15,     "Cooldown (barres)",    group=g_filt, minval=1, maxval=200)

g_strat = "── Strategy ──"
use_split = input.bool(true,   "Split TP1 / TP2 (50% / 50%)",    group=g_strat,
            tooltip="50% sort au TP1 (RR de base), 50% continue avec SL déplacé à l'entrée (breakeven).")
tp2_rr    = input.float(3.0,  "TP2 (RR) — si split activé",      group=g_strat, minval=1.0, maxval=15.0, step=0.5)

// ============================================================================
// BASE
// ============================================================================
atr     = ta.atr(atr_len)
sma200  = ta.sma(close, 200)
body    = math.abs(close - open)
up_wick = high - math.max(open, close)
dn_wick = math.min(open, close) - low
bar_h   = hour(time, "UTC")
sess_ok = not use_sess or (bar_h >= sess_start and bar_h < sess_end)

// ============================================================================
// 1. DÉTECTION FVG
// ============================================================================
b1_body         = math.abs(close[1] - open[1])
strong_bull_imp = close[1] > open[1] and b1_body >= atr[1] * impulse_mult
strong_bear_imp = close[1] < open[1] and b1_body >= atr[1] * impulse_mult

new_bull_fvg = strong_bull_imp and low  > high[2]
new_bear_fvg = strong_bear_imp and high < low[2]

var float bfvg_lo = na
var float bfvg_hi = na
var int   bfvg_b  = na
var float nfvg_lo = na
var float nfvg_hi = na
var int   nfvg_b  = na

if new_bull_fvg
    bfvg_lo := high[2]
    bfvg_hi := low
    bfvg_b  := bar_index

if new_bear_fvg
    nfvg_lo := high
    nfvg_hi := low[2]
    nfvg_b  := bar_index

// Expiration + faux FVG (retouche rapide dans les 5 barres)
if not na(bfvg_b)
    age_b = bar_index - bfvg_b
    quick_retest_bull = age_b > 0 and age_b <= 5 and low <= bfvg_hi
    if age_b > fvg_max_age or close > bfvg_hi or quick_retest_bull
        bfvg_lo := na
        bfvg_hi := na
        bfvg_b  := na

if not na(nfvg_b)
    age_n = bar_index - nfvg_b
    quick_retest_bear = age_n > 0 and age_n <= 5 and high >= nfvg_lo
    if age_n > fvg_max_age or close < nfvg_lo or quick_retest_bear
        nfvg_lo := na
        nfvg_hi := na
        nfvg_b  := na

// ============================================================================
// 2. FONCTIONS ZONE CLÉ
// ============================================================================
f_touch_count(float level, float tol_val, int lb) =>
    int cnt = 0
    for i = 1 to lb
        if math.abs(high[i] - level) <= tol_val or math.abs(low[i] - level) <= tol_val
            cnt += 1
    cnt

f_is_consolidation(int n, float max_rng) =>
    h = ta.highest(high, n)[1]
    l = ta.lowest(low,   n)[1]
    (h - l) <= max_rng

// ============================================================================
// 3. DÉTECTION NOWICK
// ============================================================================
thresh  = body * (wick_pct / 100.0)
big_bod = body >= atr * min_body_atr

bull_nw = close > open and dn_wick <= thresh and big_bod
bear_nw = close < open and up_wick <= thresh and big_bod

// ============================================================================
// 4. SETUP COMPLET
// ============================================================================
tol_v        = atr * zone_tol

bull_fvg_ok  = not na(bfvg_lo) and bfvg_lo > close
bull_zone_mt = use_mt and f_touch_count(low, tol_v, zone_lb) >= zone_min_t
bull_zone_cl = use_consol and f_is_consolidation(5, atr * consol_range)
bull_on_zone = bull_zone_mt or bull_zone_cl
sma_ok_bull  = not use_sma or close > sma200

// Garde supplémentaire en strategy : pas de nouveau signal en position ouverte
bull_setup   = bull_nw and bull_fvg_ok and bull_on_zone and sma_ok_bull and sess_ok
               and strategy.position_size == 0

bear_fvg_ok  = not na(nfvg_hi) and nfvg_hi < close
bear_zone_mt = use_mt and f_touch_count(high, tol_v, zone_lb) >= zone_min_t
bear_zone_cl = use_consol and f_is_consolidation(5, atr * consol_range)
bear_on_zone = bear_zone_mt or bear_zone_cl
sma_ok_bear  = not use_sma or close < sma200

bear_setup   = bear_nw and bear_fvg_ok and bear_on_zone and sma_ok_bear and sess_ok
               and strategy.position_size == 0

// ============================================================================
// 5. SETUP PENDING → ATTENTE DU RETEST AU 3/4
// ============================================================================
var float pb_entry = na
var float pb_sl    = na
var float pb_tp1   = na
var float pb_tp2   = na
var float pb_nw_lo = na
var int   pb_b     = na

var float ps_entry = na
var float ps_sl    = na
var float ps_tp1   = na
var float ps_tp2   = na
var float ps_nw_hi = na
var int   ps_b     = na

var int last_buy_bar  = -1000
var int last_sell_bar = -1000

if bull_setup and (bar_index - last_buy_bar) >= cooldown_b
    nw_body_sz = close - open
    entry_lv   = open + nw_body_sz * 0.75
    sl_lv      = low - atr * sl_buf
    risk_lv    = entry_lv - sl_lv
    tp1_lv     = use_fvg_tp and not na(bfvg_lo) and bfvg_lo > entry_lv
                 ? bfvg_lo : entry_lv + risk_lv * tp_fixed_rr
    tp2_lv     = entry_lv + risk_lv * tp2_rr
    rr_ok      = risk_lv > 0.0 and (tp1_lv - entry_lv) / risk_lv >= rr_min
    if rr_ok
        pb_entry := entry_lv
        pb_sl    := sl_lv
        pb_tp1   := tp1_lv
        pb_tp2   := tp2_lv
        pb_nw_lo := low
        pb_b     := bar_index

if bear_setup and (bar_index - last_sell_bar) >= cooldown_b
    nw_body_sz = open - close
    entry_lv   = open - nw_body_sz * 0.75
    sl_lv      = high + atr * sl_buf
    risk_lv    = sl_lv - entry_lv
    tp1_lv     = use_fvg_tp and not na(nfvg_hi) and nfvg_hi < entry_lv
                 ? nfvg_hi : entry_lv - risk_lv * tp_fixed_rr
    tp2_lv     = entry_lv - risk_lv * tp2_rr
    rr_ok      = risk_lv > 0.0 and (entry_lv - tp1_lv) / risk_lv >= rr_min
    if rr_ok
        ps_entry := entry_lv
        ps_sl    := sl_lv
        ps_tp1   := tp1_lv
        ps_tp2   := tp2_lv
        ps_nw_hi := high
        ps_b     := bar_index

// Expiration pending
if not na(pb_b) and (bar_index - pb_b) > entry_win
    pb_entry := na; pb_sl := na; pb_tp1 := na; pb_tp2 := na; pb_nw_lo := na; pb_b := na

if not na(ps_b) and (bar_index - ps_b) > entry_win
    ps_entry := na; ps_sl := na; ps_tp1 := na; ps_tp2 := na; ps_nw_hi := na; ps_b := na

// Invalidation (close perce la nowick)
if not na(pb_nw_lo) and close < pb_nw_lo
    pb_entry := na; pb_sl := na; pb_tp1 := na; pb_tp2 := na; pb_nw_lo := na; pb_b := na

if not na(ps_nw_hi) and close > ps_nw_hi
    ps_entry := na; ps_sl := na; ps_tp1 := na; ps_tp2 := na; ps_nw_hi := na; ps_b := na

// ============================================================================
// 6. SIGNAL DE DÉCLENCHEMENT (retest 3/4)
// ============================================================================
pb_e = pb_entry; pb_s = pb_sl; pb_t1 = pb_tp1; pb_t2 = pb_tp2
ps_e = ps_entry; ps_s = ps_sl; ps_t1 = ps_tp1; ps_t2 = ps_tp2

buy_sig  = not na(pb_entry) and pb_b < bar_index and
           low <= pb_entry and close >= pb_entry and strategy.position_size == 0

sell_sig = not na(ps_entry) and ps_b < bar_index and
           high >= ps_entry and close <= ps_entry and strategy.position_size == 0

if buy_sig
    last_buy_bar := bar_index
    pb_entry := na; pb_sl := na; pb_tp1 := na; pb_tp2 := na; pb_nw_lo := na; pb_b := na

if sell_sig
    last_sell_bar := bar_index
    ps_entry := na; ps_sl := na; ps_tp1 := na; ps_tp2 := na; ps_nw_hi := na; ps_b := na

// ============================================================================
// 7. ENTRÉES ET SORTIES STRATEGY
// ============================================================================
// Breakeven tracking
var float a_entry = na
var float a_sl    = na
var float a_tp1   = na
var float a_tp2   = na
var bool  tp1_hit = false

if buy_sig
    a_entry := pb_e
    a_sl    := pb_s
    a_tp1   := pb_t1
    a_tp2   := pb_t2
    tp1_hit := false
    strategy.entry("BUY", strategy.long, comment="BUY 3/4")
    if use_split
        strategy.exit("B_TP1", "BUY", qty_percent=50, limit=a_tp1, stop=a_sl, comment="TP1")
        strategy.exit("B_TP2", "BUY",                 limit=a_tp2, stop=a_sl, comment="TP2")
    else
        strategy.exit("B_EXIT", "BUY", limit=a_tp1, stop=a_sl, comment="TP/SL")

if sell_sig
    a_entry := ps_e
    a_sl    := ps_s
    a_tp1   := ps_t1
    a_tp2   := ps_t2
    tp1_hit := false
    strategy.entry("SELL", strategy.short, comment="SELL 3/4")
    if use_split
        strategy.exit("S_TP1", "SELL", qty_percent=50, limit=a_tp1, stop=a_sl, comment="TP1")
        strategy.exit("S_TP2", "SELL",                 limit=a_tp2, stop=a_sl, comment="TP2")
    else
        strategy.exit("S_EXIT", "SELL", limit=a_tp1, stop=a_sl, comment="TP/SL")

// Breakeven : après TP1 touché, déplacer le SL à l'entrée pour TP2
if use_split and not tp1_hit
    if strategy.position_size > 0 and not na(a_tp1) and high >= a_tp1
        tp1_hit := true
        strategy.cancel("B_TP2")
        strategy.exit("B_BE", "BUY", limit=a_tp2, stop=a_entry + syminfo.mintick, comment="BE→TP2")
    if strategy.position_size < 0 and not na(a_tp1) and low <= a_tp1
        tp1_hit := true
        strategy.cancel("S_TP2")
        strategy.exit("S_BE", "SELL", limit=a_tp2, stop=a_entry - syminfo.mintick, comment="BE→TP2")

// Reset si position fermée
if strategy.position_size == 0
    a_entry := na; a_sl := na; a_tp1 := na; a_tp2 := na; tp1_hit := false

// ============================================================================
// 8. ALERTES (alert() — alertcondition n'est pas disponible en strategy)
// ============================================================================
rr_buy  = buy_sig  and not na(pb_e) and not na(pb_s) and (pb_e - pb_s) > 0
          ? math.round((pb_t1 - pb_e) / (pb_e - pb_s), 2) : 0.0
rr_sell = sell_sig and not na(ps_e) and not na(ps_s) and (ps_s - ps_e) > 0
          ? math.round((ps_e - ps_t1) / (ps_s - ps_e), 2) : 0.0

if buy_sig
    alert("🟢 BUY "  + syminfo.ticker +
          " | TF: "  + timeframe.period + "m" +
          " | Entry: " + str.tostring(pb_e,  format.mintick) +
          " | TP1: "   + str.tostring(pb_t1, format.mintick) +
          " | SL: "    + str.tostring(pb_s,  format.mintick) +
          " | RR: 1:" + str.tostring(rr_buy) +
          " | FVG·Zone·Nowick 3/4", alert.freq_once_per_bar_close)

if sell_sig
    alert("🔴 SELL " + syminfo.ticker +
          " | TF: "  + timeframe.period + "m" +
          " | Entry: " + str.tostring(ps_e,  format.mintick) +
          " | TP1: "   + str.tostring(ps_t1, format.mintick) +
          " | SL: "    + str.tostring(ps_s,  format.mintick) +
          " | RR: 1:" + str.tostring(rr_sell) +
          " | FVG·Zone·Nowick 3/4", alert.freq_once_per_bar_close)

// ============================================================================
// 9. VISUELS (identiques à l'indicateur)
// ============================================================================
plot(use_sma ? sma200 : na, "SMA 200", color.new(color.yellow, 30), 2)

plotshape(bull_nw, "NW Bull raw", shape.triangleup,
          location.belowbar, color.new(color.lime, 75), size=size.tiny)
plotshape(bear_nw, "NW Bear raw", shape.triangledown,
          location.abovebar, color.new(color.red,  75), size=size.tiny)

plotshape(bull_setup, "Setup Bull ✓", shape.triangleup,
          location.belowbar, color.lime, size=size.small)
plotshape(bear_setup, "Setup Bear ✓", shape.triangledown,
          location.abovebar, color.red,  size=size.small)

plot(not na(pb_entry) ? pb_entry : na, "Entry BUY  pending",
     color.new(color.green, 30), 1, plot.style_linebr)
plot(not na(ps_entry) ? ps_entry : na, "Entry SELL pending",
     color.new(color.red,   30), 1, plot.style_linebr)

// SL/TP actifs (position ouverte)
plot(strategy.position_size != 0 and not na(a_sl)  ? a_sl  : na, "SL actif",
     color.new(color.red,  10), 2, plot.style_linebr)
plot(strategy.position_size != 0 and not na(a_tp1) ? a_tp1 : na, "TP1 actif",
     color.new(color.lime, 20), 2, plot.style_linebr)
plot(strategy.position_size != 0 and not na(a_tp2) and use_split ? a_tp2 : na, "TP2 actif",
     color.new(color.teal, 10), 1, plot.style_linebr)

// FVG boxes
var box bfvg_box = na
var box nfvg_box = na

if show_fvg
    if new_bull_fvg
        box.delete(bfvg_box)
        bfvg_box := box.new(bar_index - 2, low, bar_index + 5, high[2],
                            border_color=color.new(color.lime, 50),
                            bgcolor     =color.new(color.lime, 88),
                            text="FVG ▲", text_color=color.new(color.lime, 20), text_size=size.tiny)
    if new_bear_fvg
        box.delete(nfvg_box)
        nfvg_box := box.new(bar_index - 2, low[2], bar_index + 5, high,
                            border_color=color.new(color.red, 50),
                            bgcolor     =color.new(color.red, 88),
                            text="FVG ▼", text_color=color.new(color.red, 20), text_size=size.tiny)
    if not na(bfvg_b) and not na(bfvg_box)
        box.set_right(bfvg_box, bar_index + 3)
    if not na(nfvg_b) and not na(nfvg_box)
        box.set_right(nfvg_box, bar_index + 3)

// Labels sur signal
if buy_sig
    label.new(bar_index, low - atr * 0.8,
              "▲ BUY\nEntry " + str.tostring(pb_e,  "#.#####") +
              "\nTP1   " + str.tostring(pb_t1, "#.#####") +
              "\nTP2   " + str.tostring(pb_t2, "#.#####") +
              "\nSL    " + str.tostring(pb_s,  "#.#####") +
              "\nRR    1:" + str.tostring(rr_buy),
              yloc=yloc.price, style=label.style_label_up,
              color=color.new(color.green, 5), textcolor=color.white, size=size.small)
    line.new(bar_index, pb_t1, bar_index + 60, pb_t1, color=color.new(color.lime, 10), width=2, style=line.style_dashed)
    line.new(bar_index, pb_e,  bar_index + 60, pb_e,  color=color.new(color.white, 40), width=1, style=line.style_dotted)
    line.new(bar_index, pb_s,  bar_index + 60, pb_s,  color=color.new(color.red,  10), width=2, style=line.style_dashed)

if sell_sig
    label.new(bar_index, high + atr * 0.8,
              "▼ SELL\nEntry " + str.tostring(ps_e,  "#.#####") +
              "\nTP1   " + str.tostring(ps_t1, "#.#####") +
              "\nTP2   " + str.tostring(ps_t2, "#.#####") +
              "\nSL    " + str.tostring(ps_s,  "#.#####") +
              "\nRR    1:" + str.tostring(rr_sell),
              yloc=yloc.price, style=label.style_label_down,
              color=color.new(color.red, 5), textcolor=color.white, size=size.small)
    line.new(bar_index, ps_t1, bar_index + 60, ps_t1, color=color.new(color.lime, 10), width=2, style=line.style_dashed)
    line.new(bar_index, ps_e,  bar_index + 60, ps_e,  color=color.new(color.white, 40), width=1, style=line.style_dotted)
    line.new(bar_index, ps_s,  bar_index + 60, ps_s,  color=color.new(color.red,  10), width=2, style=line.style_dashed)

// ============================================================================
// 10. TABLE DE PERFORMANCE
// ============================================================================
if barstate.islast
    var table t = table.new(position.top_right, 2, 13,
                  bgcolor      = color.new(color.black, 80),
                  border_color = color.new(color.gray,  60),
                  border_width = 1)

    c_w = color.white; c_g = color.lime; c_r = color.red; c_y = color.yellow; c_a = color.aqua
    sz  = size.small;  sz2 = size.tiny

    table.cell(t, 0, 0, "FVG·Zone·Nowick", text_color=c_y, text_size=sz,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.cell(t, 1, 0, "STRATEGY v1",     text_color=c_a, text_size=sz,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)

    // Performance
    n_closed = strategy.closedtrades
    wr       = n_closed > 0 ? strategy.wintrades / n_closed * 100 : 0.0
    pf       = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    pnl      = strategy.netprofit
    dd       = strategy.max_drawdown_percent

    table.cell(t, 0, 1, "Win Rate",       text_color=c_w, text_size=sz)
    table.cell(t, 1, 1, str.tostring(math.round(wr, 1)) + "%",
               text_color=wr >= 55 ? c_g : wr >= 40 ? c_y : c_r, text_size=sz)

    table.cell(t, 0, 2, "Profit Factor",  text_color=c_w, text_size=sz)
    table.cell(t, 1, 2, str.tostring(math.round(pf, 2)),
               text_color=pf >= 1.5 ? c_g : pf >= 1.0 ? c_y : c_r, text_size=sz)

    table.cell(t, 0, 3, "Net P&L",        text_color=c_w, text_size=sz)
    table.cell(t, 1, 3, "$" + str.tostring(math.round(pnl, 0)),
               text_color=pnl >= 0 ? c_g : c_r, text_size=sz)

    table.cell(t, 0, 4, "Max DD",          text_color=c_w, text_size=sz)
    table.cell(t, 1, 4, str.tostring(math.round(dd, 1)) + "%",
               text_color=dd <= 10 ? c_g : dd <= 20 ? c_y : c_r, text_size=sz)

    table.cell(t, 0, 5, "Trades fermés",  text_color=c_w, text_size=sz)
    table.cell(t, 1, 5, str.tostring(n_closed), text_color=c_w, text_size=sz)

    // Trades/semaine (M15 : 96 barres/jour × 5 jours)
    weeks = (bar_index + 1) / (96.0 * 5.0)
    tpw   = n_closed > 0 ? n_closed / math.max(weeks, 1) : 0.0
    table.cell(t, 0, 6, "Trades/semaine", text_color=c_w, text_size=sz)
    table.cell(t, 1, 6, str.tostring(math.round(tpw, 1)),
               text_color=tpw >= 2 and tpw <= 8 ? c_g : c_y, text_size=sz)

    table.cell(t, 0, 7, "Avg Win",        text_color=c_w, text_size=sz)
    table.cell(t, 1, 7, "$" + str.tostring(math.round(strategy.avg_winning_trade, 2)),
               text_color=c_g, text_size=sz)

    table.cell(t, 0, 8, "Avg Loss",       text_color=c_w, text_size=sz)
    table.cell(t, 1, 8, "$" + str.tostring(math.round(strategy.avg_losing_trade, 2)),
               text_color=c_r, text_size=sz)

    // Trend + session
    trend_str = close > sma200 ? "▲ BULL" : "▼ BEAR"
    table.cell(t, 0, 9, "Trend SMA200",   text_color=c_w, text_size=sz)
    table.cell(t, 1, 9, trend_str, text_color=close > sma200 ? c_g : c_r, text_size=sz)

    table.cell(t, 0, 10, "Session",       text_color=c_w, text_size=sz)
    table.cell(t, 1, 10, sess_ok ? "OPEN ✓" : "FERMÉE",
               text_color=sess_ok ? c_g : color.gray, text_size=sz)

    // Filtres actifs
    f_str = (use_sma ? "SMA200 " : "") + (use_sess ? "SESSION " : "") +
            (use_consol ? "CONSOL " : "") + (use_mt ? "MT " : "") +
            (use_split ? "SPLIT" : "SINGLE TP")
    table.cell(t, 0, 11, "Filtres",       text_color=c_w, text_size=sz2)
    table.cell(t, 1, 11, f_str,           text_color=c_a, text_size=sz2)

    // Position actuelle
    pos_str = strategy.position_size > 0 ? "▲ LONG" :
              strategy.position_size < 0 ? "▼ SHORT" : "—"
    table.cell(t, 0, 12, "Position",      text_color=c_w, text_size=sz)
    table.cell(t, 1, 12, pos_str,
               text_color=strategy.position_size > 0 ? c_g :
                           strategy.position_size < 0 ? c_r : color.gray, text_size=sz)
