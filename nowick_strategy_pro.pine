// ============================================================================
// NOWICK STRATEGY PRO - Brad.fx Optimized (STRATEGY / BACKTEST VERSION)
// Version: 3.0 | M15 Forex | Target: 60%+ WR | 1:1.5 min RR | 4-8 trades/week
//
// USE THIS FILE IN: TradingView → Strategy Tester (for backtesting & optimization)
// USE nowick_indicator_pro.pine: for live chart trading
//
// KEY FILTERS (v3.0):
//   1. HTF Trend (1H EMA20/50) — only trade in macro direction
//   2. RSI zones 40/60 — tighter than v2 (was 50/50)
//   3. ADX ≥ 20 — only trending markets (not choppy ranges)
//   4. Swing structure — signal must fire at N-bar extreme
//   5. Cooldown 20 bars — max ~1 signal per 5 hours → 4-8/week
//   6. Session UTC hour filter — London + NY only (7-17h)
//   7. Volume ≥ 0.8x MA
// ============================================================================

//@version=5
strategy("Nowick Strategy PRO v3.0",
         overlay=true,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=1,
         initial_capital=10000,
         commission_type=strategy.commission.percent,
         commission_value=0.003,
         slippage=1,
         calc_on_every_tick=false,
         max_bars_back=500)

// ============================================================================
// INPUTS
// ============================================================================

grp1 = "🕯️ Wickless Detection"
wick_max_pct  = input.float(5.0, "Max Wick % of Body",     minval=0.0, maxval=30.0, step=0.5, group=grp1)
min_body_atr  = input.float(0.5, "Min Body (x ATR)",        minval=0.1, maxval=2.0,  step=0.1, group=grp1)
atr_len       = input.int(14,   "ATR Length",               minval=5, maxval=50,              group=grp1)

grp2 = "📈 HTF Trend"
use_htf       = input.bool(true, "Enable HTF Filter",       group=grp2)
htf_tf        = input.timeframe("60", "HTF Timeframe",      group=grp2)
htf_fast      = input.int(20,   "HTF Fast EMA",             group=grp2)
htf_slow      = input.int(50,   "HTF Slow EMA",             group=grp2)

grp3 = "📊 RSI"
use_rsi       = input.bool(true, "Enable RSI Filter",       group=grp3)
rsi_len       = input.int(14,   "RSI Length",               group=grp3)
rsi_buy_max   = input.int(40,   "Max RSI for BUY",          minval=20, maxval=60, group=grp3)
rsi_sell_min  = input.int(60,   "Min RSI for SELL",         minval=40, maxval=80, group=grp3)
rsi_ext_buy   = input.int(30,   "Strong BUY (RSI <)",       group=grp3)
rsi_ext_sell  = input.int(70,   "Strong SELL (RSI >)",      group=grp3)

grp4 = "💪 ADX Trend Strength"
use_adx       = input.bool(true, "Enable ADX Filter",       group=grp4)
adx_len       = input.int(14,   "ADX Length",               group=grp4)
adx_min       = input.int(20,   "Min ADX",                  minval=10, maxval=40, group=grp4)

grp5 = "🔲 Swing Structure"
use_swing     = input.bool(true, "Signal at Swing Extreme", group=grp5)
swing_bars    = input.int(10,   "Swing Lookback",           minval=3, maxval=30,  group=grp5)
swing_tol_atr = input.float(0.5,"Swing Tolerance (x ATR)", minval=0.1, maxval=2.0, step=0.1, group=grp5)

grp6 = "⏱️ Cooldown"
cooldown_bars = input.int(20,   "Min Bars Between Signals", minval=4, maxval=100, group=grp6)

grp7 = "🕐 Session"
use_session   = input.bool(true, "Enable Session Filter",   group=grp7)
sess_start_h  = input.int(7,    "Start Hour (UTC)",         minval=0, maxval=23,  group=grp7)
sess_end_h    = input.int(17,   "End Hour (UTC)",           minval=1, maxval=23,  group=grp7)

grp8 = "📦 Volume"
use_vol       = input.bool(true, "Enable Volume Filter",    group=grp8)
vol_ma_len    = input.int(20,   "Volume MA Length",         group=grp8)
vol_min_mult  = input.float(0.8,"Min Volume (x MA)",        minval=0.3, maxval=3.0, step=0.1, group=grp8)

grp9 = "🎯 SL / TP"
sl_atr_mult   = input.float(1.2,"SL ATR Multiplier",        minval=0.5, maxval=4.0, step=0.1, group=grp9)
sl_buffer     = input.float(0.00015,"SL Min Buffer",        minval=0.0, step=0.00005,          group=grp9)
tp1_rr        = input.float(1.5,"TP1 Risk:Reward",          minval=1.0, maxval=8.0,  step=0.1, group=grp9)
tp2_rr        = input.float(2.5,"TP2 Risk:Reward",          minval=1.0, maxval=10.0, step=0.1, group=grp9)
split_tp      = input.bool(true, "Split 60% TP1 / 40% TP2",group=grp9)
use_be        = input.bool(true, "Move SL to BE after TP1", group=grp9)

grp10 = "🎨 Display"
show_sma200   = input.bool(true, "Show SMA 200",            group=grp10)
show_sltp     = input.bool(true, "Show active trade SL/TP", group=grp10)

// ============================================================================
// CALCULATIONS
// ============================================================================
atr    = ta.atr(atr_len)
sma200 = ta.sma(close, 200)
rsi    = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_ma_len)

[_, _, adx_val] = ta.dmi(adx_len, adx_len)

[htf_ema_f, htf_ema_s] = request.security(syminfo.tickerid, htf_tf,
     [ta.ema(close, htf_fast), ta.ema(close, htf_slow)],
     lookahead=barmerge.lookahead_off)
htf_bull = htf_ema_f > htf_ema_s
htf_bear = htf_ema_f < htf_ema_s

body       = math.abs(close - open)
upper_wick = high - math.max(open, close)
lower_wick = math.min(open, close) - low
is_bull    = close > open
is_bear    = close < open

wick_thresh  = body * (wick_max_pct / 100.0)
min_body_val = atr * min_body_atr

wickless_bull = is_bull and upper_wick <= wick_thresh and body >= min_body_val
wickless_bear = is_bear and lower_wick <= wick_thresh and body >= min_body_val

// ============================================================================
// FILTERS
// ============================================================================
bar_hour   = hour(time, "UTC")
session_ok = not use_session or (bar_hour >= sess_start_h and bar_hour < sess_end_h)
vol_ok     = not use_vol or (volume >= vol_ma * vol_min_mult)
rsi_ok_buy = not use_rsi or rsi <= rsi_buy_max
rsi_ok_sel = not use_rsi or rsi >= rsi_sell_min
adx_ok     = not use_adx or adx_val >= adx_min
htf_ok_buy = not use_htf or htf_bull
htf_ok_sel = not use_htf or htf_bear

swing_low_level  = ta.lowest(low,  swing_bars)
swing_high_level = ta.highest(high, swing_bars)
near_swing_lo    = not use_swing or low  <= swing_low_level  + atr * swing_tol_atr
near_swing_hi    = not use_swing or high >= swing_high_level - atr * swing_tol_atr

var int last_buy_bar  = -1000
var int last_sell_bar = -1000
buy_cd  = (bar_index - last_buy_bar)  >= cooldown_bars
sell_cd = (bar_index - last_sell_bar) >= cooldown_bars

// ============================================================================
// SIGNALS
// ============================================================================
buy_signal  = wickless_bear and htf_ok_buy and rsi_ok_buy and vol_ok and session_ok and adx_ok and near_swing_lo  and buy_cd  and strategy.position_size == 0
sell_signal = wickless_bull and htf_ok_sel and rsi_ok_sel and vol_ok and session_ok and adx_ok and near_swing_hi and sell_cd and strategy.position_size == 0

strong_buy  = buy_signal  and rsi <= rsi_ext_buy
strong_sell = sell_signal and rsi >= rsi_ext_sell

if buy_signal
    last_buy_bar  := bar_index
if sell_signal
    last_sell_bar := bar_index

// ============================================================================
// SL / TP
// ============================================================================
var float a_sl   = na
var float a_tp1  = na
var float a_tp2  = na
var float a_entry= na

if buy_signal
    sl   = math.min(low - sl_buffer, close - atr * sl_atr_mult)
    risk = close - sl
    tp1  = close + risk * tp1_rr
    tp2  = close + risk * (strong_buy  ? tp2_rr + 0.5 : tp2_rr)
    a_sl    := sl
    a_tp1   := tp1
    a_tp2   := tp2
    a_entry := close
    strategy.entry("BUY", strategy.long, comment="BUY" + (strong_buy ? "★" : ""))
    if split_tp
        strategy.exit("BUY_TP1", "BUY", qty_percent=60, limit=tp1, stop=sl, comment="TP1")
        strategy.exit("BUY_TP2", "BUY", qty_percent=40, limit=tp2, stop=sl, comment="TP2")
    else
        strategy.exit("BUY_EXIT","BUY", limit=tp1, stop=sl)

if sell_signal
    sl   = math.max(high + sl_buffer, close + atr * sl_atr_mult)
    risk = sl - close
    tp1  = close - risk * tp1_rr
    tp2  = close - risk * (strong_sell ? tp2_rr + 0.5 : tp2_rr)
    a_sl    := sl
    a_tp1   := tp1
    a_tp2   := tp2
    a_entry := close
    strategy.entry("SELL", strategy.short, comment="SELL" + (strong_sell ? "★" : ""))
    if split_tp
        strategy.exit("SELL_TP1","SELL", qty_percent=60, limit=tp1, stop=sl, comment="TP1")
        strategy.exit("SELL_TP2","SELL", qty_percent=40, limit=tp2, stop=sl, comment="TP2")
    else
        strategy.exit("SELL_EXIT","SELL", limit=tp1, stop=sl)

// Move to BE after TP1 hit
if use_be and strategy.position_size > 0  and not na(a_tp1) and high >= a_tp1
    strategy.exit("BUY_BE", "BUY", stop=a_entry * 1.00005)
if use_be and strategy.position_size < 0 and not na(a_tp1) and low  <= a_tp1
    strategy.exit("SEL_BE", "SELL", stop=a_entry * 0.99995)

// Clear on flat
if strategy.position_size == 0
    a_sl := na ; a_tp1 := na ; a_tp2 := na

// ============================================================================
// VISUALS
// ============================================================================
plotshape(buy_signal  and not strong_buy,  "BUY",      shape.labelup,   location.belowbar, color.new(color.green, 10), text="BUY",    textcolor=color.white, size=size.small)
plotshape(sell_signal and not strong_sell, "SELL",     shape.labeldown, location.abovebar, color.new(color.red,   10), text="SELL",   textcolor=color.white, size=size.small)
plotshape(strong_buy,                      "BUY ★",    shape.labelup,   location.belowbar, color.lime,                 text="BUY ★",  textcolor=color.black, size=size.normal)
plotshape(strong_sell,                     "SELL ★",   shape.labeldown, location.abovebar, color.maroon,               text="SELL ★", textcolor=color.white, size=size.normal)

plot(show_sma200 ? sma200 : na, "SMA 200", color.new(color.yellow, 20), 2)

plot(show_sltp and strategy.position_size != 0 ? a_sl  : na, "SL",  color.new(color.red,   10), 2, plot.style_linebr)
plot(show_sltp and strategy.position_size != 0 ? a_tp1 : na, "TP1", color.new(color.lime,  20), 2, plot.style_linebr)
plot(show_sltp and strategy.position_size != 0 ? a_tp2 : na, "TP2", color.new(color.green, 10), 1, plot.style_linebr)

// ============================================================================
// STATS TABLE
// ============================================================================
if barstate.islast
    var table t = table.new(position.top_right, 2, 12,
         bgcolor=color.new(color.black, 75), border_color=color.new(color.gray, 50), border_width=1)

    table.cell(t, 0, 0, "NOWICK PRO v3.0", text_color=color.white, text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.cell(t, 1, 0, "STRATEGY",         text_color=color.yellow, text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)

    wr = strategy.wintrades / math.max(strategy.closedtrades, 1) * 100
    pf = strategy.grossprofit / math.max(strategy.grossloss, 0.001)

    table.cell(t, 0, 1,  "Win Rate",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1,  str.tostring(math.round(wr, 1)) + "%",
               text_color=wr >= 60 ? color.lime : wr >= 50 ? color.yellow : color.red, text_size=size.small)

    table.cell(t, 0, 2,  "Profit Factor", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2,  str.tostring(math.round(pf, 2)),
               text_color=pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.small)

    table.cell(t, 0, 3,  "Net P&L",     text_color=color.white, text_size=size.small)
    pnl = strategy.netprofit
    table.cell(t, 1, 3,  "$" + str.tostring(math.round(pnl, 0)),
               text_color=pnl >= 0 ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 4,  "Trades",      text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4,  str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)

    table.cell(t, 0, 5,  "Max DD",      text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5,  str.tostring(math.round(strategy.max_drawdown_percent, 1)) + "%",
               text_color=strategy.max_drawdown_percent <= 10 ? color.lime :
                           strategy.max_drawdown_percent <= 20 ? color.yellow : color.red,
               text_size=size.small)

    table.cell(t, 0, 6,  "Avg Win",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6,  "$" + str.tostring(math.round(strategy.avg_winning_trade, 1)),
               text_color=color.lime, text_size=size.small)

    table.cell(t, 0, 7,  "Avg Loss",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7,  "$" + str.tostring(math.round(strategy.avg_losing_trade, 1)),
               text_color=color.red, text_size=size.small)

    table.cell(t, 0, 8,  "HTF",         text_color=color.white, text_size=size.small)
    table.cell(t, 1, 8,  htf_bull ? "▲ BULL" : "▼ BEAR",
               text_color=htf_bull ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 9,  "RSI",         text_color=color.white, text_size=size.small)
    table.cell(t, 1, 9,  str.tostring(math.round(rsi, 1)),
               text_color=rsi >= rsi_ext_sell ? color.red : rsi <= rsi_ext_buy ? color.lime : color.gray,
               text_size=size.small)

    table.cell(t, 0, 10, "ADX",         text_color=color.white, text_size=size.small)
    table.cell(t, 1, 10, str.tostring(math.round(adx_val, 1)),
               text_color=adx_val >= adx_min ? color.lime : color.gray, text_size=size.small)

    table.cell(t, 0, 11, "Session",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 11, session_ok ? "✓ (" + str.tostring(bar_hour) + "h)" : "✗ OFF",
               text_color=session_ok ? color.lime : color.gray, text_size=size.small)
