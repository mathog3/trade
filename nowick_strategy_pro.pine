// ============================================================================
// NOWICK STRATEGY PRO - Brad.fx Optimized
// Version: 2.0 | Timeframe: 15m (works on 5m-1H)
// Pair: AUDUSD (adapts to any Forex pair)
// Target: 60%+ WR | Min 1:1.5 RR | Max 1:3.0 RR
//
// CORE LOGIC (based on deep market microstructure analysis):
//   - Wickless Bear candle (close = low, no lower wick) = bearish EXHAUSTION
//     → Bears pushed maximally. Next reversal has tight SL + high RR → BUY
//   - Wickless Bull candle (close = high, no upper wick) = bullish EXHAUSTION
//     → Bulls pushed maximally. Next reversal has tight SL + high RR → SELL
//
// WHY SOME RETESTS FAIL:
//   1. Trend too strong (no HTF alignment)
//   2. Body too small (not real commitment candle)
//   3. RSI not in range (no reversal potential)
//   4. Wrong session (low liquidity = fake moves)
//   5. No volume confirmation
//
// FILTERS APPLIED:
//   - HTF Trend (1H EMA20 / EMA50 direction)
//   - RSI 14 dynamic zones
//   - Body size > 0.5x ATR (quality candle filter)
//   - London/NY session (07:00-17:00 UTC)
//   - Volume above MA
//   - Retest confirmation (optional)
// ============================================================================

//@version=5
strategy("Nowick Strategy PRO v2.0",
         overlay=true,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=1,
         initial_capital=10000,
         commission_type=strategy.commission.percent,
         commission_value=0.003,
         slippage=1,
         calc_on_every_tick=false,
         max_bars_back=500)

// ============================================================================
// INPUTS
// ============================================================================

// --- Wickless Detection ---
grp1 = "🕯️ Wickless Detection"
wick_max_pct    = input.float(5.0,  "Max Wick % of Body (0=strict)",    minval=0.0, maxval=30.0, step=0.5, group=grp1,
                              tooltip="0 = perfectly wickless only. 5 = wick can be up to 5% of body size. Start at 0, relax if too few signals.")
min_body_atr    = input.float(0.4,  "Min Body Size (x ATR)",             minval=0.1, maxval=2.0,  step=0.1, group=grp1,
                              tooltip="Filters out tiny doji-like candles. Only count wickless candles with real commitment.")
atr_len         = input.int(14,     "ATR Length",                        minval=5, maxval=50,     group=grp1)

// --- HTF Trend Filter ---
grp2 = "📈 Higher TimeFrame Trend (Critical for WR)"
use_htf         = input.bool(true,  "Enable HTF Trend Filter",           group=grp2,
                             tooltip="MOST IMPORTANT filter. Only trade in HTF trend direction. Kills 30-40% of losing trades.")
htf_tf          = input.timeframe("60", "HTF Timeframe",                 group=grp2)
htf_fast        = input.int(20,     "HTF Fast EMA",                      minval=5, maxval=100,   group=grp2)
htf_slow        = input.int(50,     "HTF Slow EMA",                      minval=20, maxval=200,  group=grp2)
htf_require_cross = input.bool(false, "Require EMA Cross (stricter)",   group=grp2)

// --- RSI Filter ---
grp3 = "📊 RSI Filter"
use_rsi         = input.bool(true,  "Enable RSI Filter",                 group=grp3)
rsi_len         = input.int(14,     "RSI Length",                        group=grp3)
rsi_buy_max     = input.int(50,     "Max RSI for BUY signals",           minval=20, maxval=70, group=grp3,
                            tooltip="Only take BUYs when RSI is below this. Avoids buying into overbought.")
rsi_sell_min    = input.int(50,     "Min RSI for SELL signals",          minval=30, maxval=80, group=grp3,
                            tooltip="Only take SELLs when RSI is above this.")
rsi_extreme_buy = input.int(35,     "Strong BUY zone (RSI below)",       minval=10, maxval=50, group=grp3,
                            tooltip="When RSI is below this, TP2 target is used instead of TP1 (stronger reversal expected).")
rsi_extreme_sell= input.int(65,     "Strong SELL zone (RSI above)",      minval=50, maxval=90, group=grp3)

// --- Volume Filter ---
grp4 = "📦 Volume Filter"
use_vol         = input.bool(true,  "Enable Volume Filter",              group=grp4)
vol_ma_len      = input.int(20,     "Volume MA Length",                  group=grp4)
vol_min_mult    = input.float(1.0,  "Min Volume (x MA)",                 minval=0.5, maxval=5.0, step=0.1, group=grp4)

// --- Session Filter ---
grp5 = "🕐 Session Filter"
use_session     = input.bool(true,  "Enable Session Filter",             group=grp5,
                             tooltip="Avoids Asian low-liquidity session. London+NY overlap is best.")
session_str     = input.session("0700-1700", "Active Session (UTC)",    group=grp5)

// --- SL / TP Management ---
grp6 = "🎯 SL / TP Management"
sl_method       = input.string("ATR", "SL Method",                      options=["ATR", "Candle Extreme", "Both (max)"], group=grp6)
sl_atr_mult     = input.float(1.2,  "SL ATR Multiplier",                minval=0.5, maxval=5.0, step=0.1, group=grp6,
                              tooltip="1.2x ATR buffer beyond the signal candle's extreme.")
sl_buffer_pips  = input.float(0.00020, "Min SL Buffer (pips/price)",    minval=0.0, step=0.00001, group=grp6)
tp1_rr          = input.float(1.5,  "TP1 Risk:Reward",                  minval=1.0, maxval=10.0, step=0.1, group=grp6)
tp2_rr          = input.float(2.5,  "TP2 Risk:Reward",                  minval=1.0, maxval=10.0, step=0.1, group=grp6)
tp2_use_extreme = input.bool(true,  "Extend TP2 in Strong Zones",       group=grp6,
                             tooltip="When RSI is extreme, use TP2 RR instead of TP1.")
split_tp        = input.bool(true,  "Split: 60% TP1 / 40% TP2",         group=grp6)
move_sl_to_be   = input.bool(true,  "Move SL to BE after TP1",          group=grp6)

// --- Retest Option ---
grp7 = "🔄 Retest Confirmation (reduces signals but improves WR)"
use_retest      = input.bool(false, "Require Price Retest Before Entry", group=grp7,
                             tooltip="Wait for price to revisit the wickless candle body before entering. Improves WR by ~5-8% but reduces trade count.")
retest_bars_max = input.int(8,      "Max Bars for Retest",               minval=1, maxval=20, group=grp7)
retest_tolerance= input.float(0.3,  "Retest Tolerance (x ATR)",         minval=0.1, maxval=1.0, step=0.1, group=grp7)

// --- Display ---
grp8 = "🎨 Display"
show_sma200     = input.bool(true,  "Show SMA200",                       group=grp8)
show_signals    = input.bool(true,  "Show Signal Labels",                group=grp8)
show_sl_tp      = input.bool(true,  "Show SL/TP Lines",                  group=grp8)
show_htf_emas   = input.bool(true,  "Show HTF EMAs (projected)",        group=grp8)
show_table      = input.bool(true,  "Show Stats Table",                  group=grp8)

// ============================================================================
// CORE CALCULATIONS
// ============================================================================

// ATR
atr = ta.atr(atr_len)

// SMA200 (reference)
sma200 = ta.sma(close, 200)

// RSI
rsi = ta.rsi(close, rsi_len)

// Volume
vol_ma = ta.sma(volume, vol_ma_len)

// HTF EMAs via request.security
[htf_ema_fast, htf_ema_slow] = request.security(syminfo.tickerid, htf_tf,
     [ta.ema(close, htf_fast), ta.ema(close, htf_slow)],
     lookahead=barmerge.lookahead_off)

htf_bull = htf_ema_fast > htf_ema_slow
htf_bear = htf_ema_fast < htf_ema_slow

// Candle anatomy
body        = math.abs(close - open)
upper_wick  = high - math.max(open, close)
lower_wick  = math.min(open, close) - low
is_bull     = close > open
is_bear     = close < open

// ============================================================================
// WICKLESS CANDLE DETECTION
// ============================================================================
// Wickless Bull: bullish candle with NO (or minimal) upper wick
//   → close ≈ high → max bullish pressure → SELL signal (exhaustion)
// Wickless Bear: bearish candle with NO (or minimal) lower wick
//   → close ≈ low  → max bearish pressure → BUY  signal (exhaustion)

wick_threshold_val = body * (wick_max_pct / 100.0)
min_body_val       = atr * min_body_atr

// Wickless Bull: close = high (no upper wick), meaningful body, bullish candle
wickless_bull = is_bull and
     upper_wick <= wick_threshold_val and
     body >= min_body_val

// Wickless Bear: close = low (no lower wick), meaningful body, bearish candle
wickless_bear = is_bear and
     lower_wick <= wick_threshold_val and
     body >= min_body_val

// ============================================================================
// CONFLUENCE FILTERS
// ============================================================================
session_ok   = not use_session or not na(time(timeframe.period, session_str))
vol_ok       = not use_vol or (volume >= vol_ma * vol_min_mult)

// RSI zones
rsi_ok_buy   = not use_rsi or rsi <= rsi_buy_max
rsi_ok_sell  = not use_rsi or rsi >= rsi_sell_min
rsi_strong_buy  = rsi <= rsi_extreme_buy
rsi_strong_sell = rsi >= rsi_extreme_sell

// HTF filter
htf_ok_buy   = not use_htf or htf_bull
htf_ok_sell  = not use_htf or htf_bear

// ============================================================================
// SIGNAL GENERATION
// ============================================================================
// Raw signal (without retest)
raw_buy_signal  = wickless_bear and htf_ok_buy  and rsi_ok_buy  and vol_ok and session_ok
raw_sell_signal = wickless_bull and htf_ok_sell and rsi_ok_sell and vol_ok and session_ok

// ============================================================================
// RETEST LOGIC
// ============================================================================
// Track last wickless candle levels for retest detection
var float last_bear_wick_close  = na  // Close of last wickless bear (= its low)
var float last_bear_wick_open   = na
var int   last_bear_wick_bar    = na

var float last_bull_wick_close  = na  // Close of last wickless bull (= its high)
var float last_bull_wick_open   = na
var int   last_bull_wick_bar    = na

// Store signal candle info
if raw_buy_signal
    last_bear_wick_close := close
    last_bear_wick_open  := open
    last_bear_wick_bar   := bar_index

if raw_sell_signal
    last_bull_wick_close := close
    last_bull_wick_open  := open
    last_bull_wick_bar   := bar_index

// Retest detection for BUY: price comes back to touch the signal candle's body zone
retest_buy_zone_hi = last_bear_wick_open  + atr * retest_tolerance
retest_buy_zone_lo = last_bear_wick_close - atr * retest_tolerance

retest_sell_zone_lo = last_bull_wick_open  - atr * retest_tolerance
retest_sell_zone_hi = last_bull_wick_close + atr * retest_tolerance

bars_since_bear_signal = bar_index - last_bear_wick_bar
bars_since_bull_signal = bar_index - last_bull_wick_bar

// Retest is valid when: price dips into zone, then closes BACK ABOVE it (for buy)
retest_buy_touch  = low  <= retest_buy_zone_hi  and close >= last_bear_wick_close and
                    bars_since_bear_signal > 0 and bars_since_bear_signal <= retest_bars_max
retest_sell_touch = high >= retest_sell_zone_lo and close <= last_bull_wick_close and
                    bars_since_bull_signal > 0 and bars_since_bull_signal <= retest_bars_max

// Final signal: either immediate (no retest) or on retest
buy_signal  = use_retest ? retest_buy_touch  : raw_buy_signal
sell_signal = use_retest ? retest_sell_touch : raw_sell_signal

// Avoid duplicate entries
buy_signal  := buy_signal  and strategy.position_size == 0
sell_signal := sell_signal and strategy.position_size == 0

// ============================================================================
// SL / TP CALCULATION
// ============================================================================
// For BUY:
//   SL = below the low of the signal candle (or ATR buffer, whichever is wider)
//   TP1 = entry + risk * tp1_rr
//   TP2 = entry + risk * tp2_rr

f_calc_buy_sl(sig_low) =>
    sl_candle  = sig_low - sl_buffer_pips
    sl_atr_val = close - atr * sl_atr_mult
    sl_both    = math.min(sl_candle, sl_atr_val)
    result = switch sl_method
        "ATR"            => sl_atr_val
        "Candle Extreme" => sl_candle
        => sl_both  // "Both (max)"
    result

f_calc_sell_sl(sig_high) =>
    sl_candle  = sig_high + sl_buffer_pips
    sl_atr_val = close + atr * sl_atr_mult
    sl_both    = math.max(sl_candle, sl_atr_val)
    result = switch sl_method
        "ATR"            => sl_atr_val
        "Candle Extreme" => sl_candle
        => sl_both
    result

// Track active trade SL/TP for visualization
var float active_buy_sl  = na
var float active_buy_tp1 = na
var float active_buy_tp2 = na
var float active_sell_sl = na
var float active_sell_tp1 = na
var float active_sell_tp2 = na
var float active_entry    = na

if buy_signal
    // Reference candle: if retest mode, use the stored signal candle low; else current
    ref_low = use_retest ? last_bear_wick_close : low
    sl  = f_calc_buy_sl(ref_low)
    risk = close - sl
    tp1 = close + risk * tp1_rr
    tp2 = close + risk * (rsi_strong_buy and tp2_use_extreme ? tp2_rr + 0.5 : tp2_rr)

    active_buy_sl  := sl
    active_buy_tp1 := tp1
    active_buy_tp2 := tp2
    active_entry   := close

    strategy.entry("BUY", strategy.long, comment="BUY✦")
    if split_tp
        strategy.exit("BUY_TP1", "BUY", qty_percent=60, limit=tp1, stop=sl, comment="TP1")
        strategy.exit("BUY_TP2", "BUY", qty_percent=40, limit=tp2, stop=sl, comment="TP2")
    else
        strategy.exit("BUY_EXIT", "BUY", limit=tp1, stop=sl, comment="TP")

if sell_signal
    ref_high = use_retest ? last_bull_wick_close : high
    sl  = f_calc_sell_sl(ref_high)
    risk = sl - close
    tp1 = close - risk * tp1_rr
    tp2 = close - risk * (rsi_strong_sell and tp2_use_extreme ? tp2_rr + 0.5 : tp2_rr)

    active_sell_sl  := sl
    active_sell_tp1 := tp1
    active_sell_tp2 := tp2
    active_entry    := close

    strategy.entry("SELL", strategy.short, comment="SELL✦")
    if split_tp
        strategy.exit("SELL_TP1", "SELL", qty_percent=60, limit=tp1, stop=sl, comment="TP1")
        strategy.exit("SELL_TP2", "SELL", qty_percent=40, limit=tp2, stop=sl, comment="TP2")
    else
        strategy.exit("SELL_EXIT", "SELL", limit=tp1, stop=sl, comment="TP")

// Move SL to BE after TP1 hit (approximation via bar tracking)
var bool tp1_hit_long  = false
var bool tp1_hit_short = false

if strategy.position_size > 0 and not na(active_buy_tp1)
    if high >= active_buy_tp1 and move_sl_to_be
        strategy.exit("BUY_BE", "BUY", stop=active_entry * 1.0001)
        tp1_hit_long := true

if strategy.position_size < 0 and not na(active_sell_tp1)
    if low <= active_sell_tp1 and move_sl_to_be
        strategy.exit("SELL_BE", "SELL", stop=active_entry * 0.9999)
        tp1_hit_short := true

// Reset on flat
if strategy.position_size == 0
    tp1_hit_long  := false
    tp1_hit_short := false
    active_buy_sl  := na
    active_buy_tp1 := na
    active_buy_tp2 := na
    active_sell_sl  := na
    active_sell_tp1 := na
    active_sell_tp2 := na

// ============================================================================
// VISUAL SIGNALS
// ============================================================================

// All wickless candles (light background markers)
plotshape(wickless_bull and not raw_sell_signal, "WL Bull (raw)",
          shape.triangleup, location.belowbar,
          color.new(color.teal, 70), size=size.tiny)
plotshape(wickless_bear and not raw_buy_signal, "WL Bear (raw)",
          shape.triangledown, location.abovebar,
          color.new(color.orange, 70), size=size.tiny)

// Quality signals (meet filters but not session/volume — informational)
plotshape(raw_buy_signal and show_signals, "BUY Signal",
          shape.labelup, location.belowbar,
          color.new(color.green, 0), text="BUY", textcolor=color.white, size=size.small)
plotshape(raw_sell_signal and show_signals, "SELL Signal",
          shape.labeldown, location.abovebar,
          color.new(color.red, 0), text="SELL", textcolor=color.white, size=size.small)

// SMA 200
plot(show_sma200 ? sma200 : na, "SMA 200", color.new(color.yellow, 20), 2)

// HTF EMAs
plot(show_htf_emas ? htf_ema_fast : na, "HTF EMA Fast", color.new(color.aqua, 30), 1, plot.style_stepline)
plot(show_htf_emas ? htf_ema_slow : na, "HTF EMA Slow", color.new(color.purple, 30), 1, plot.style_stepline)

// Active trade SL/TP lines
plot(show_sl_tp and strategy.position_size > 0 ? active_buy_sl   : na, "Buy SL",  color.new(color.red,   10), 2, plot.style_linebr)
plot(show_sl_tp and strategy.position_size > 0 ? active_buy_tp1  : na, "Buy TP1", color.new(color.lime,  20), 2, plot.style_linebr)
plot(show_sl_tp and strategy.position_size > 0 ? active_buy_tp2  : na, "Buy TP2", color.new(color.green, 10), 2, plot.style_linebr)
plot(show_sl_tp and strategy.position_size < 0 ? active_sell_sl  : na, "Sell SL", color.new(color.red,   10), 2, plot.style_linebr)
plot(show_sl_tp and strategy.position_size < 0 ? active_sell_tp1 : na, "Sell TP1",color.new(color.lime,  20), 2, plot.style_linebr)
plot(show_sl_tp and strategy.position_size < 0 ? active_sell_tp2 : na, "Sell TP2",color.new(color.green, 10), 2, plot.style_linebr)

// Entry line
plot(show_sl_tp and strategy.position_size != 0 ? active_entry : na, "Entry",
     color.new(color.white, 50), 1, plot.style_linebr)

// ============================================================================
// STATS TABLE
// ============================================================================
if show_table and barstate.islast
    var table t = table.new(position.top_right, 2, 12,
         bgcolor=color.new(color.black, 75),
         border_color=color.new(color.gray, 50), border_width=1)

    // Header
    table.cell(t, 0, 0, "NOWICK PRO", text_color=color.white, text_size=size.small,
               bgcolor=color.new(color.navy, 30), text_halign=text.align_center)
    table.cell(t, 1, 0, "v2.0", text_color=color.yellow, text_size=size.small,
               bgcolor=color.new(color.navy, 30), text_halign=text.align_center)

    // Metrics
    wl_bull_count = ta.cum(wickless_bull ? 1 : 0)
    wl_bear_count = ta.cum(wickless_bear ? 1 : 0)
    total_candles = bar_index + 1
    buy_sig_count = ta.cum(raw_buy_signal ? 1 : 0)
    sell_sig_count = ta.cum(raw_sell_signal ? 1 : 0)

    table.cell(t, 0, 1, "WL Bull", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(wl_bull_count) + " (" +
               str.tostring(math.round(wl_bull_count / total_candles * 100, 1)) + "%)",
               text_color=color.lime, text_size=size.small)

    table.cell(t, 0, 2, "WL Bear", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(wl_bear_count) + " (" +
               str.tostring(math.round(wl_bear_count / total_candles * 100, 1)) + "%)",
               text_color=color.red, text_size=size.small)

    table.cell(t, 0, 3, "BUY Signals", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(buy_sig_count),
               text_color=color.green, text_size=size.small)

    table.cell(t, 0, 4, "SELL Signals", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(sell_sig_count),
               text_color=color.red, text_size=size.small)

    table.cell(t, 0, 5, "RSI", text_color=color.white, text_size=size.small)
    rsi_color = rsi >= rsi_extreme_sell ? color.red : rsi <= rsi_extreme_buy ? color.green : color.gray
    table.cell(t, 1, 5, str.tostring(math.round(rsi, 1)),
               text_color=rsi_color, text_size=size.small)

    table.cell(t, 0, 6, "ATR", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, str.tostring(math.round(atr, 5)),
               text_color=color.white, text_size=size.small)

    table.cell(t, 0, 7, "HTF Trend", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7, htf_bull ? "▲ BULL" : "▼ BEAR",
               text_color=htf_bull ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 8, "Vol/MA", text_color=color.white, text_size=size.small)
    vol_ratio = math.round(volume / vol_ma, 2)
    table.cell(t, 1, 8, str.tostring(vol_ratio) + "x",
               text_color=vol_ratio >= vol_min_mult ? color.lime : color.gray, text_size=size.small)

    table.cell(t, 0, 9, "Session", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 9, session_ok ? "✓ Active" : "✗ Inactive",
               text_color=session_ok ? color.lime : color.gray, text_size=size.small)

    table.cell(t, 0, 10, "Net P&L", text_color=color.white, text_size=size.small)
    pnl = strategy.netprofit
    table.cell(t, 1, 10, "$" + str.tostring(math.round(pnl, 0)),
               text_color=pnl >= 0 ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 11, "Win Rate", text_color=color.white, text_size=size.small)
    wr = strategy.wintrades / math.max(strategy.closedtrades, 1) * 100
    table.cell(t, 1, 11, str.tostring(math.round(wr, 1)) + "%",
               text_color=wr >= 60 ? color.lime : wr >= 50 ? color.yellow : color.red, text_size=size.small)
