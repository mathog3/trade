// ============================================================================
// NOWICK STRATEGY PRO — Brad.fx (BACKTEST VERSION)
// Version: 4.0 | M15 Forex | Vraie logique + Retest
//
// LOGIQUE BRAD.FX (CORRIGÉE) :
//  BUY  = bougie VERTE sans mèche basse (uptrend) → RETEST du low → entrée
//  SELL = bougie ROUGE sans mèche haute (downtrend) → RETEST du high → entrée
//  Sweep accepté si CLOSE tient le niveau
//  Invalidation si CLOSE casse le niveau avant le retest
// ============================================================================

//@version=5
strategy("Nowick Strategy PRO v4.0 — Brad.fx",
         overlay=true,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=1,
         initial_capital=10000,
         commission_type=strategy.commission.percent,
         commission_value=0.003,
         slippage=1,
         calc_on_every_tick=false,
         max_bars_back=500)

// ============================================================================
// INPUTS
// ============================================================================

grp1 = "Nowick (Détection)"
wick_pct     = input.float(5.0,  "Mèche max (% du corps)",   minval=0.0, maxval=25.0, step=0.5,  group=grp1)
min_body_atr = input.float(0.4,  "Corps min (× ATR)",        minval=0.1, maxval=2.0,  step=0.1,  group=grp1)
atr_len      = input.int(14,     "ATR length",               minval=5,   maxval=50,              group=grp1)

grp2 = "Retest"
retest_bars  = input.int(8,      "Fenêtre retest (barres)",  minval=1,   maxval=30,              group=grp2)
retest_tol   = input.float(0.2,  "Tolérance sweep (× ATR)", minval=0.0, maxval=1.0,  step=0.05, group=grp2)

grp3 = "Trend & Structure"
use_htf      = input.bool(true,  "Filtre HTF EMA",           group=grp3)
htf_tf       = input.timeframe("60", "TF HTF",               group=grp3)
htf_fast     = input.int(20,     "EMA rapide HTF",           group=grp3)
htf_slow     = input.int(50,     "EMA lente HTF",            group=grp3)
use_struct   = input.bool(true,  "Filtre structure locale",  group=grp3)
swing_len    = input.int(5,      "Swing length",             minval=2,   maxval=20,              group=grp3)

grp4 = "Filtres additionnels"
use_rsi      = input.bool(false, "Filtre RSI",               group=grp4)
rsi_len      = input.int(14,     "RSI length",               group=grp4)
rsi_buy_max  = input.int(55,     "RSI max BUY",              minval=30,  maxval=70,              group=grp4)
rsi_sell_min = input.int(45,     "RSI min SELL",             minval=30,  maxval=70,              group=grp4)
use_adx      = input.bool(false, "Filtre ADX",               group=grp4)
adx_len      = input.int(14,     "ADX length",               group=grp4)
adx_min      = input.int(20,     "ADX minimum",              minval=10,  maxval=40,              group=grp4)
use_sess     = input.bool(true,  "Filtre session UTC",       group=grp4)
sess_start   = input.int(7,      "Début UTC",                minval=0,   maxval=23,              group=grp4)
sess_end     = input.int(17,     "Fin UTC",                  minval=1,   maxval=23,              group=grp4)
cooldown_b   = input.int(15,     "Cooldown (barres)",        minval=1,   maxval=100,             group=grp4)

grp5 = "SL / TP"
sl_buf       = input.float(0.3,  "SL buffer (× ATR)",       minval=0.0, maxval=2.0,  step=0.1,  group=grp5)
tp1_rr       = input.float(2.0,  "TP1 (RR)",                minval=0.5, maxval=10.0, step=0.5,  group=grp5)
tp2_rr       = input.float(3.0,  "TP2 (RR)",                minval=0.5, maxval=10.0, step=0.5,  group=grp5)
split_tp     = input.bool(true,  "Split 60% TP1 / 40% TP2", group=grp5)
use_be       = input.bool(true,  "Move SL to BE après TP1", group=grp5)

grp6 = "Affichage"
show_sma200  = input.bool(true,  "SMA 200",                  group=grp6)
show_sltp    = input.bool(true,  "SL/TP sur chart",          group=grp6)

// ============================================================================
// CALCULS
// ============================================================================
atr    = ta.atr(atr_len)
sma200 = ta.sma(close, 200)
rsi    = ta.rsi(close, rsi_len)

[_, _, adx_val] = ta.dmi(adx_len, adx_len)

[htf_ef, htf_es] = request.security(syminfo.tickerid, htf_tf,
     [ta.ema(close, htf_fast), ta.ema(close, htf_slow)],
     lookahead=barmerge.lookahead_off)
htf_bull = htf_ef > htf_es
htf_bear = htf_ef < htf_es

// ─── DÉTECTION NOWICK ─────────────────────────────────────────────
body    = math.abs(close - open)
up_wick = high - math.max(open, close)
dn_wick = math.min(open, close) - low
thresh  = body * (wick_pct / 100.0)
big_bod = body >= atr * min_body_atr

// BULL NOWICK : bougie VERTE + pas de mèche basse → marque SUPPORT au low
bull_nw = close > open and dn_wick <= thresh and big_bod

// BEAR NOWICK : bougie ROUGE + pas de mèche haute → marque RÉSISTANCE au high
bear_nw = close < open and up_wick <= thresh and big_bod

// ─── STRUCTURE LOCALE ─────────────────────────────────────────────
ph = ta.pivothigh(high, swing_len, swing_len)
pl = ta.pivotlow(low,   swing_len, swing_len)
var float last_ph = na
var float last_pl = na
if not na(ph)
    last_ph := ph
if not na(pl)
    last_pl := pl

bos_bull = not na(last_ph) and close > last_ph and close[1] <= last_ph
bos_bear = not na(last_pl) and close < last_pl and close[1] >= last_pl
var int trend = 0
if bos_bull
    trend := 1
if bos_bear
    trend := -1

// ─── FILTRES ──────────────────────────────────────────────────────
bar_h   = hour(time, "UTC")
sess_ok = not use_sess or (bar_h >= sess_start and bar_h < sess_end)
rsi_buy = not use_rsi  or rsi <= rsi_buy_max
rsi_sel = not use_rsi  or rsi >= rsi_sell_min
adx_ok  = not use_adx  or adx_val >= adx_min

trend_buy  = (not use_htf or htf_bull) and (not use_struct or trend == 1)
trend_sell = (not use_htf or htf_bear) and (not use_struct or trend == -1)

in_pullback_buy  = not use_struct or (not na(last_ph) and close < last_ph)
in_pullback_sell = not use_struct or (not na(last_pl) and close > last_pl)

// ─── NOWICK VALIDE ────────────────────────────────────────────────
valid_bull_nw = bull_nw and trend_buy  and in_pullback_buy  and strategy.position_size == 0
valid_bear_nw = bear_nw and trend_sell and in_pullback_sell and strategy.position_size == 0

// ─── STOCKAGE NIVEAU NOWICK ───────────────────────────────────────
var float nw_buy_lo = na
var float nw_buy_cl = na
var int   nw_buy_b  = na

var float nw_sel_hi = na
var float nw_sel_cl = na
var int   nw_sel_b  = na

if valid_bull_nw
    nw_buy_lo := low
    nw_buy_cl := close
    nw_buy_b  := bar_index

if valid_bear_nw
    nw_sel_hi := high
    nw_sel_cl := close
    nw_sel_b  := bar_index

// ─── EXPIRATION + INVALIDATION ────────────────────────────────────
age_buy  = na(nw_buy_b) ? na : bar_index - nw_buy_b
age_sell = na(nw_sel_b) ? na : bar_index - nw_sel_b

if not na(age_buy) and age_buy > retest_bars
    nw_buy_lo := na
    nw_buy_b  := na

if not na(age_sell) and age_sell > retest_bars
    nw_sel_hi := na
    nw_sel_b  := na

// Invalidation : CLOSE casse le niveau
if not na(nw_buy_lo) and close < nw_buy_lo - atr * 0.05
    nw_buy_lo := na
    nw_buy_b  := na

if not na(nw_sel_hi) and close > nw_sel_hi + atr * 0.05
    nw_sel_hi := na
    nw_sel_b  := na

// ─── DÉTECTION RETEST ─────────────────────────────────────────────
tol = atr * retest_tol

retest_buy  = not na(nw_buy_lo) and
              age_buy > 0 and age_buy <= retest_bars and
              low  <= nw_buy_lo + tol and
              close >= nw_buy_lo

retest_sell = not na(nw_sel_hi) and
              age_sell > 0 and age_sell <= retest_bars and
              high >= nw_sel_hi - tol and
              close <= nw_sel_hi

// ─── COOLDOWN ─────────────────────────────────────────────────────
var int last_buy_b  = -1000
var int last_sell_b = -1000
buy_cd  = (bar_index - last_buy_b)  >= cooldown_b
sell_cd = (bar_index - last_sell_b) >= cooldown_b

// ─── SIGNAUX ──────────────────────────────────────────────────────
buy_sig  = retest_buy  and sess_ok and rsi_buy and adx_ok and buy_cd  and strategy.position_size == 0
sell_sig = retest_sell and sess_ok and rsi_sel and adx_ok and sell_cd and strategy.position_size == 0

// ─── SL / TP ──────────────────────────────────────────────────────
// SL = sous le low du nowick (support retesté) + prend aussi le low du retest si plus bas
_buy_sl_nw  = buy_sig  ? math.min(nw_buy_lo, low) - atr * sl_buf : na
_sel_sl_nw  = sell_sig ? math.max(nw_sel_hi, high) + atr * sl_buf : na

buy_sl  = _buy_sl_nw
sell_sl = _sel_sl_nw

buy_risk  = not na(buy_sl)  ? close - buy_sl  : na
sell_risk = not na(sell_sl) ? sell_sl - close : na

buy_tp1  = not na(buy_risk)  ? close + buy_risk  * tp1_rr : na
buy_tp2  = not na(buy_risk)  ? close + buy_risk  * tp2_rr : na
sell_tp1 = not na(sell_risk) ? close - sell_risk * tp1_rr : na
sell_tp2 = not na(sell_risk) ? close - sell_risk * tp2_rr : na

// ─── CONSOMMER LE NIVEAU ──────────────────────────────────────────
if buy_sig
    last_buy_b := bar_index
    nw_buy_lo  := na
    nw_buy_b   := na

if sell_sig
    last_sell_b := bar_index
    nw_sel_hi   := na
    nw_sel_b    := na

// ─── ORDRES STRATEGY ──────────────────────────────────────────────
var float a_entry = na
var float a_sl    = na
var float a_tp1   = na
var float a_tp2   = na

if buy_sig
    a_entry := close
    a_sl    := buy_sl
    a_tp1   := buy_tp1
    a_tp2   := buy_tp2
    strategy.entry("BUY", strategy.long, comment="BUY | NW Retest")
    if split_tp
        strategy.exit("BUY_TP1", "BUY", qty_percent=60, limit=buy_tp1, stop=buy_sl, comment="TP1")
        strategy.exit("BUY_TP2", "BUY", qty_percent=40, limit=buy_tp2, stop=buy_sl, comment="TP2")
    else
        strategy.exit("BUY_EXIT","BUY", limit=buy_tp1, stop=buy_sl)

if sell_sig
    a_entry := close
    a_sl    := sell_sl
    a_tp1   := sell_tp1
    a_tp2   := sell_tp2
    strategy.entry("SELL", strategy.short, comment="SELL | NW Retest")
    if split_tp
        strategy.exit("SELL_TP1","SELL", qty_percent=60, limit=sell_tp1, stop=sell_sl, comment="TP1")
        strategy.exit("SELL_TP2","SELL", qty_percent=40, limit=sell_tp2, stop=sell_sl, comment="TP2")
    else
        strategy.exit("SELL_EXIT","SELL", limit=sell_tp1, stop=sell_sl)

// Breakeven après TP1
if use_be and strategy.position_size > 0 and not na(a_tp1) and high >= a_tp1
    strategy.exit("BUY_BE", "BUY", stop=a_entry + syminfo.mintick * 2)
if use_be and strategy.position_size < 0 and not na(a_tp1) and low <= a_tp1
    strategy.exit("SEL_BE", "SELL", stop=a_entry - syminfo.mintick * 2)

// Reset sur flat
if strategy.position_size == 0
    a_sl    := na
    a_tp1   := na
    a_tp2   := na

// ============================================================================
// VISUELS
// ============================================================================
// Nowick valide (filtré)
plotshape(valid_bull_nw, "Bull NW", shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(valid_bear_nw, "Bear NW", shape.triangledown, location.abovebar, color.red,  size=size.small)

// Signaux d'entrée (au retest)
plotshape(buy_sig,  "BUY",  shape.labelup,   location.belowbar,
          color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.normal)
plotshape(sell_sig, "SELL", shape.labeldown, location.abovebar,
          color.new(color.red,   0), text="SELL", textcolor=color.white, size=size.normal)

// SL/TP lines
plot(show_sltp and strategy.position_size != 0 ? a_sl  : na, "SL",  color.new(color.red,   10), 2, plot.style_linebr)
plot(show_sltp and strategy.position_size != 0 ? a_tp1 : na, "TP1", color.new(color.lime,  20), 2, plot.style_linebr)
plot(show_sltp and strategy.position_size != 0 ? a_tp2 : na, "TP2", color.new(color.green, 10), 1, plot.style_linebr)

plot(show_sma200 ? sma200 : na, "SMA 200", color.new(color.yellow, 20), 2)

bgcolor(htf_bull ? color.new(color.green, 97) : htf_bear ? color.new(color.red, 97) : na)

// ============================================================================
// STATS TABLE
// ============================================================================
if barstate.islast
    var table t = table.new(position.top_right, 2, 12,
         bgcolor=color.new(color.black, 75),
         border_color=color.new(color.gray, 50), border_width=1)

    table.cell(t, 0, 0, "NOWICK v4.0",   text_color=color.white,  text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.cell(t, 1, 0, "BACKTEST",       text_color=color.yellow, text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)

    wr = strategy.wintrades / math.max(strategy.closedtrades, 1) * 100
    pf = strategy.grossprofit / math.max(strategy.grossloss, 0.001)

    table.cell(t, 0, 1,  "Win Rate",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1,  str.tostring(math.round(wr, 1)) + "%",
               text_color=wr >= 55 ? color.lime : wr >= 45 ? color.yellow : color.red, text_size=size.small)

    table.cell(t, 0, 2,  "Profit Factor", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2,  str.tostring(math.round(pf, 2)),
               text_color=pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.small)

    table.cell(t, 0, 3,  "Net P&L",      text_color=color.white, text_size=size.small)
    pnl = strategy.netprofit
    table.cell(t, 1, 3,  "$" + str.tostring(math.round(pnl, 0)),
               text_color=pnl >= 0 ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 4,  "Trades",       text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4,  str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)

    table.cell(t, 0, 5,  "Max DD",       text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5,  str.tostring(math.round(strategy.max_drawdown_percent, 1)) + "%",
               text_color=strategy.max_drawdown_percent <= 10 ? color.lime :
                           strategy.max_drawdown_percent <= 20 ? color.yellow : color.red,
               text_size=size.small)

    table.cell(t, 0, 6,  "Avg Win",      text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6,  "$" + str.tostring(math.round(strategy.avg_winning_trade, 1)),
               text_color=color.lime, text_size=size.small)

    table.cell(t, 0, 7,  "Avg Loss",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7,  "$" + str.tostring(math.round(strategy.avg_losing_trade, 1)),
               text_color=color.red, text_size=size.small)

    table.cell(t, 0, 8,  "HTF",          text_color=color.white, text_size=size.small)
    table.cell(t, 1, 8,  htf_bull ? "▲ BULL" : "▼ BEAR",
               text_color=htf_bull ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 9,  "Trend LTF",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 9,  trend == 1 ? "▲ BULL" : trend == -1 ? "▼ BEAR" : "— RANGE",
               text_color=trend == 1 ? color.lime : trend == -1 ? color.red : color.gray, text_size=size.small)

    table.cell(t, 0, 10, "NW BUY",       text_color=color.white, text_size=size.small)
    table.cell(t, 1, 10, not na(nw_buy_lo) ? "En attente (" + str.tostring(age_buy) + "b)" : "—",
               text_color=not na(nw_buy_lo) ? color.lime : color.gray, text_size=size.small)

    table.cell(t, 0, 11, "NW SELL",      text_color=color.white, text_size=size.small)
    table.cell(t, 1, 11, not na(nw_sel_hi) ? "En attente (" + str.tostring(age_sell) + "b)" : "—",
               text_color=not na(nw_sel_hi) ? color.red : color.gray, text_size=size.small)
