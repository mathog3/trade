// ============================================================================
// HUSS ICT INDICES v2 — Score-based | NQ/ES/DAX
// Signal quand score >= min_score (pas besoin de TOUT simultanément)
// Critères : SMT divergence + Liquidity Sweep + FVG + Trend EMA
// ============================================================================

//@version=6
indicator("Huss ICT v2 — Score Signal", overlay=true,
          max_bars_back=500, max_labels_count=200,
          max_lines_count=300, max_boxes_count=200)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
g_smt = "── SMT Divergence ──"
smt_ticker   = input.symbol("ES1!", "Paire corrélée (NQ→ES | ES→NQ | DAX→FDAX)", group=g_smt)
smt_lookback = input.int(5, "Lookback swing SMT", minval=2, maxval=15, group=g_smt)

g_fvg = "── FVG / Imbalance ──"
use_fvg  = input.bool(true,  "Activer zones FVG", group=g_fvg)
fvg_min  = input.float(0.15, "Taille min FVG (× ATR)", minval=0.05, step=0.05, group=g_fvg)
fvg_mem  = input.int(60, "Mémoire FVG (barres)", minval=10, maxval=200, group=g_fvg)

g_sig = "── Signal ──"
min_score    = input.int(2, "Score min (sur 4) pour signal", minval=1, maxval=4, group=g_sig)
cooldown     = input.int(8, "Cooldown entre signaux (barres)", minval=3, maxval=50, group=g_sig)
use_sess     = input.bool(false, "Filtrer session NY (14-23h UTC)", group=g_sig)
atr_len      = input.int(14, "ATR length", minval=5, group=g_sig)

g_tp = "── SL / TP ──"
sl_look = input.int(5,   "Lookback structure SL", minval=2, maxval=15, group=g_tp)
sl_buf  = input.float(0.3, "SL buffer (× ATR)",  minval=0, step=0.1,  group=g_tp)
tp1_rr  = input.float(2.0, "TP1 RR",             minval=0.5, step=0.5, group=g_tp)
tp2_rr  = input.float(3.5, "TP2 RR",             minval=0.5, step=0.5, group=g_tp)

// ─── BASE ─────────────────────────────────────────────────────────────────────
atr    = ta.atr(atr_len)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

sess_ok = not use_sess or (hour(time, "UTC") >= 14 and hour(time, "UTC") < 23)

// ─── 1. SMT DIVERGENCE ───────────────────────────────────────────────────────
// Bull SMT : prix fait nouveau LL mais corrélé ne confirme pas (HL)
// Bear SMT : prix fait nouveau HH mais corrélé ne confirme pas (LH)
smt_lo = request.security(smt_ticker, timeframe.period, low,  lookahead=barmerge.lookahead_off)
smt_hi = request.security(smt_ticker, timeframe.period, high, lookahead=barmerge.lookahead_off)

prev_lo_main = ta.lowest(low[1],     smt_lookback)
prev_hi_main = ta.highest(high[1],   smt_lookback)
prev_lo_smt  = ta.lowest(smt_lo[1],  smt_lookback)
prev_hi_smt  = ta.highest(smt_hi[1], smt_lookback)

smt_bull = low  < prev_lo_main and smt_lo > prev_lo_smt
smt_bear = high > prev_hi_main and smt_hi < prev_hi_smt

var int last_smt_b = -999
var int last_smt_s = -999
if smt_bull
    last_smt_b := bar_index
if smt_bear
    last_smt_s := bar_index

smt_bull_ok = bar_index - last_smt_b <= 20
smt_bear_ok = bar_index - last_smt_s <= 20

// ─── 2. LIQUIDITY SWEEP ───────────────────────────────────────────────────────
// Perce un niveau clé (20 barres) puis revient = manipulation
swing_hi = ta.highest(high[1], 20)
swing_lo = ta.lowest(low[1],   20)

sweep_bull = low < swing_lo and close > swing_lo and (close - low) > atr * 0.3
sweep_bear = high > swing_hi and close < swing_hi and (high - close) > atr * 0.3

var int last_sw_b = -999
var int last_sw_s = -999
if sweep_bull
    last_sw_b := bar_index
if sweep_bear
    last_sw_s := bar_index

sweep_bull_ok = bar_index - last_sw_b <= 15
sweep_bear_ok = bar_index - last_sw_s <= 15

// ─── 3. FVG (Fair Value Gap) ─────────────────────────────────────────────────
bull_fvg_raw = use_fvg and high[2] < low[0] and (low[0] - high[2]) >= atr * fvg_min
bear_fvg_raw = use_fvg and low[2]  > high[0] and (low[2] - high[0]) >= atr * fvg_min

var float[] bfvg_top = array.new_float(0)
var float[] bfvg_bot = array.new_float(0)
var int[]   bfvg_bar = array.new_int(0)

var float[] sfvg_top = array.new_float(0)
var float[] sfvg_bot = array.new_float(0)
var int[]   sfvg_bar = array.new_int(0)

if bull_fvg_raw
    array.unshift(bfvg_top, low[0])
    array.unshift(bfvg_bot, high[2])
    array.unshift(bfvg_bar, bar_index)

if bear_fvg_raw
    array.unshift(sfvg_top, low[2])
    array.unshift(sfvg_bot, high[0])
    array.unshift(sfvg_bar, bar_index)

// Purge des vieilles zones
ib = 0
while ib < array.size(bfvg_bar)
    if bar_index - array.get(bfvg_bar, ib) > fvg_mem
        array.remove(bfvg_top, ib)
        array.remove(bfvg_bot, ib)
        array.remove(bfvg_bar, ib)
    else
        ib += 1

js = 0
while js < array.size(sfvg_bar)
    if bar_index - array.get(sfvg_bar, js) > fvg_mem
        array.remove(sfvg_top, js)
        array.remove(sfvg_bot, js)
        array.remove(sfvg_bar, js)
    else
        js += 1

// Prix dans zone FVG
in_bull_fvg = false
in_bear_fvg = false

if array.size(bfvg_top) > 0
    for k = 0 to array.size(bfvg_top) - 1
        if close >= array.get(bfvg_bot, k) and close <= array.get(bfvg_top, k)
            in_bull_fvg := true

if array.size(sfvg_top) > 0
    for k = 0 to array.size(sfvg_top) - 1
        if close >= array.get(sfvg_bot, k) and close <= array.get(sfvg_top, k)
            in_bear_fvg := true

// Dessin FVG
if bull_fvg_raw
    box.new(bar_index - 2, high[2], bar_index + 40, low[0],
            border_color=color.new(color.teal, 40), bgcolor=color.new(color.teal, 82), border_width=1)

if bear_fvg_raw
    box.new(bar_index - 2, high[0], bar_index + 40, low[2],
            border_color=color.new(color.orange, 40), bgcolor=color.new(color.orange, 82), border_width=1)

// ─── 4. TENDANCE (EMA Filter) ─────────────────────────────────────────────────
bull_trend = close > ema50
bear_trend = close < ema50

// ─── SCORE ───────────────────────────────────────────────────────────────────
// +1 par critère validé : SMT + Sweep + FVG + Trend
bull_score = (smt_bull_ok ? 1 : 0) + (sweep_bull_ok ? 1 : 0) +
             (in_bull_fvg ? 1 : 0) + (bull_trend ? 1 : 0)

bear_score = (smt_bear_ok ? 1 : 0) + (sweep_bear_ok ? 1 : 0) +
             (in_bear_fvg ? 1 : 0) + (bear_trend ? 1 : 0)

// ─── SIGNAL ───────────────────────────────────────────────────────────────────
var int last_buy  = -999
var int last_sell = -999

cd_buy  = bar_index - last_buy  >= cooldown
cd_sell = bar_index - last_sell >= cooldown

// barstate.isconfirmed = signal sur bougie clôturée (pas de repaint)
buy_sig  = bull_score >= min_score and sess_ok and cd_buy  and barstate.isconfirmed
sell_sig = bear_score >= min_score and sess_ok and cd_sell and barstate.isconfirmed

if buy_sig
    last_buy := bar_index
if sell_sig
    last_sell := bar_index

// ─── SL / TP ─────────────────────────────────────────────────────────────────
sl_buy  = buy_sig  ? ta.lowest(low,   sl_look) - atr * sl_buf : na
sl_sell = sell_sig ? ta.highest(high, sl_look) + atr * sl_buf : na

risk_buy  = not na(sl_buy)  ? close - sl_buy  : na
risk_sell = not na(sl_sell) ? sl_sell - close : na

tp1_buy  = not na(risk_buy)  ? close + risk_buy  * tp1_rr : na
tp2_buy  = not na(risk_buy)  ? close + risk_buy  * tp2_rr : na
tp1_sell = not na(risk_sell) ? close - risk_sell * tp1_rr : na
tp2_sell = not na(risk_sell) ? close - risk_sell * tp2_rr : na

// ─── LABELS ───────────────────────────────────────────────────────────────────
if buy_sig
    lbl = "▲ BUY  [" + str.tostring(bull_score) + "/4]\n" +
          "Entry  " + str.tostring(close,   format.mintick) + "\n" +
          "TP1    " + str.tostring(tp1_buy, format.mintick) + "\n" +
          "TP2    " + str.tostring(tp2_buy, format.mintick) + "\n" +
          "SL     " + str.tostring(sl_buy,  format.mintick)
    label.new(bar_index, low - atr * 1.2,
              lbl, yloc=yloc.price,
              color=color.new(color.green, 0), textcolor=color.white,
              style=label.style_label_up, size=size.normal)
    line.new(bar_index, sl_buy,  bar_index + 50, sl_buy,  color=color.red,  width=2, style=line.style_dashed)
    line.new(bar_index, tp1_buy, bar_index + 50, tp1_buy, color=color.lime, width=2, style=line.style_dashed)
    line.new(bar_index, tp2_buy, bar_index + 50, tp2_buy, color=color.teal, width=1, style=line.style_dashed)

if sell_sig
    lbl = "▼ SELL [" + str.tostring(bear_score) + "/4]\n" +
          "Entry  " + str.tostring(close,    format.mintick) + "\n" +
          "TP1    " + str.tostring(tp1_sell, format.mintick) + "\n" +
          "TP2    " + str.tostring(tp2_sell, format.mintick) + "\n" +
          "SL     " + str.tostring(sl_sell,  format.mintick)
    label.new(bar_index, high + atr * 1.2,
              lbl, yloc=yloc.price,
              color=color.new(color.red, 0), textcolor=color.white,
              style=label.style_label_down, size=size.normal)
    line.new(bar_index, sl_sell,  bar_index + 50, sl_sell,  color=color.red,  width=2, style=line.style_dashed)
    line.new(bar_index, tp1_sell, bar_index + 50, tp1_sell, color=color.lime, width=2, style=line.style_dashed)
    line.new(bar_index, tp2_sell, bar_index + 50, tp2_sell, color=color.teal, width=1, style=line.style_dashed)

// ─── VISUELS ──────────────────────────────────────────────────────────────────
plot(ema50,  "EMA 50",  color=color.new(color.orange, 30), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.purple, 30), linewidth=2)

plotshape(sweep_bull, "Sweep Bull", shape.triangleup,   location.belowbar, color.new(color.aqua,    20), size=size.tiny)
plotshape(sweep_bear, "Sweep Bear", shape.triangledown, location.abovebar, color.new(color.fuchsia, 20), size=size.tiny)
plotshape(smt_bull,   "SMT Bull",   shape.diamond,      location.belowbar, color.new(color.lime,    10), size=size.small)
plotshape(smt_bear,   "SMT Bear",   shape.diamond,      location.abovebar, color.new(color.red,     10), size=size.small)

// ─── TABLE STATUS ─────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 10,
     bgcolor=color.new(color.black, 75),
     border_color=color.new(color.gray, 50), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "HUSS ICT v2",   text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.cell(t, 1, 0, syminfo.ticker,  text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.cell(t, 0, 1, "Session",        text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 1, sess_ok ? "✓ Active" : "✗ Fermée", text_color=sess_ok ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 2, "SMT Bull",       text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 2, smt_bull_ok ? "✓" : "—", text_color=smt_bull_ok ? color.lime : color.gray, text_size=size.small)
    table.cell(t, 0, 3, "SMT Bear",       text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 3, smt_bear_ok ? "✓" : "—", text_color=smt_bear_ok ? color.red  : color.gray, text_size=size.small)
    table.cell(t, 0, 4, "Sweep Bull",     text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 4, sweep_bull_ok ? "✓" : "—", text_color=sweep_bull_ok ? color.lime : color.gray, text_size=size.small)
    table.cell(t, 0, 5, "Sweep Bear",     text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 5, sweep_bear_ok ? "✓" : "—", text_color=sweep_bear_ok ? color.red  : color.gray, text_size=size.small)
    table.cell(t, 0, 6, "FVG Bull",       text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 6, in_bull_fvg ? "✓" : "—", text_color=in_bull_fvg ? color.lime : color.gray, text_size=size.small)
    table.cell(t, 0, 7, "FVG Bear",       text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 7, in_bear_fvg ? "✓" : "—", text_color=in_bear_fvg ? color.orange : color.gray, text_size=size.small)
    table.cell(t, 0, 8, "EMA Trend",      text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 8, bull_trend ? "▲ Bull" : "▼ Bear", text_color=bull_trend ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 9, "Score B / S",    text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 9, str.tostring(bull_score) + " / " + str.tostring(bear_score),
               text_color=bull_score > bear_score ? color.lime : bear_score > bull_score ? color.red : color.gray,
               text_size=size.small)

// ─── ALERTES ──────────────────────────────────────────────────────────────────
alertcondition(buy_sig,             "HUSS BUY",  "{{ticker}} BUY signal | TF {{interval}} | Entry {{close}}")
alertcondition(sell_sig,            "HUSS SELL", "{{ticker}} SELL signal | TF {{interval}} | Entry {{close}}")
alertcondition(buy_sig or sell_sig, "HUSS ANY",  "{{ticker}} Signal | TF {{interval}} | Entry {{close}}")
