//@version=6
indicator("Nowick PRO — Brad.fx", overlay=true, max_bars_back=500)

// ══════════════════════════════════════════════════════════════════
//  NOWICK RETEST — Brad.fx
//
//  LOGIQUE:
//  • Wickless Bear (close = low, pas de wick bas) → SUPPORT
//  • Wickless Bull (close = high, pas de wick haut) → RÉSISTANCE
//  • Le prix ESCAPE du niveau (confirme son importance)
//  • Le prix RETESTE + bougie de CONFIRMATION → ENTRÉE
//
//  FILTRES:
//  • HTF EMA 20/50 (1H) — alignement tendance
//  • Session London/NY (7h-17h UTC)
//  • Cooldown anti-clustering
//  • Bougie de confirmation (close du bon côté)
//
//  SL  : sous/au-dessus de la wickless candle + buffer ATR
//  TP1 : 1.5 × Risk  |  TP2 : 2.5 × Risk
// ══════════════════════════════════════════════════════════════════

// ─── INPUTS ───────────────────────────────────────────────────────
g1 = "Wickless"
wick_max     = input.float(5.0,  "Wick max (% body)",          minval=0,   maxval=20,  step=1.0, group=g1)
min_body_atr = input.float(0.4,  "Body min (× ATR)",           minval=0.1, maxval=2.0, step=0.1, group=g1)
atr_len      = input.int(14,     "ATR",                        minval=5,   maxval=50,            group=g1)

g2 = "Retest"
escape_mult  = input.float(0.6,  "Escape min (× ATR)",         minval=0.2, maxval=3.0, step=0.1, group=g2)
retest_zone  = input.float(0.4,  "Zone retest (× ATR)",        minval=0.1, maxval=1.5, step=0.1, group=g2)
max_bars     = input.int(60,     "Expiry (barres)",            minval=10,  maxval=300,            group=g2)
cooldown_b   = input.int(6,      "Cooldown (barres min)",      minval=1,   maxval=30,             group=g2)

g3 = "HTF Trend (1H)"
use_htf      = input.bool(true,  "Filtre HTF",                 group=g3)
htf_tf       = input.timeframe("60", "Timeframe",              group=g3)
ema_fast     = input.int(20,     "EMA rapide",                 group=g3)
ema_slow     = input.int(50,     "EMA lente",                  group=g3)

g4 = "Session"
use_sess     = input.bool(true,  "Filtre session",             group=g4)
sess_start   = input.int(7,      "Début UTC",                  minval=0,   maxval=23, group=g4)
sess_end     = input.int(17,     "Fin UTC",                    minval=1,   maxval=23, group=g4)

g5 = "SL / TP"
sl_buf       = input.float(0.8,  "Buffer SL (× ATR)",         minval=0.2, maxval=3.0, step=0.1, group=g5)
tp1_rr       = input.float(1.5,  "TP1 (RR)",                  minval=1.0, maxval=5.0, step=0.1, group=g5)
tp2_rr       = input.float(2.5,  "TP2 (RR)",                  minval=1.0, maxval=8.0, step=0.1, group=g5)
line_bars    = input.int(50,     "Lignes visibles (barres)",  minval=5,   maxval=200,            group=g5)

// ─── BASE ─────────────────────────────────────────────────────────
atr    = ta.atr(atr_len)
sma200 = ta.sma(close, 200)

[htf_ef, htf_es] = request.security(syminfo.tickerid, htf_tf,
     [ta.ema(close, ema_fast), ta.ema(close, ema_slow)],
     lookahead=barmerge.lookahead_off)
htf_bull = htf_ef > htf_es
htf_bear = htf_ef < htf_es

bar_h   = hour(time, "UTC")
sess_ok = not use_sess or (bar_h >= sess_start and bar_h < sess_end)
t_bull  = not use_htf or htf_bull
t_bear  = not use_htf or htf_bear

// ─── WICKLESS DETECTION ───────────────────────────────────────────
body       = math.abs(close - open)
up_wick    = high - math.max(open, close)
dn_wick    = math.min(open, close) - low
thresh     = body * (wick_max / 100.0)
big_enough = body >= atr * min_body_atr

wc_bear = close < open and dn_wick <= thresh and big_enough  // → SUPPORT
wc_bull = close > open and up_wick <= thresh and big_enough  // → RÉSISTANCE

// ─── STATE MACHINE — SUPPORT ──────────────────────────────────────
var float s_lvl   = na   // Niveau support = close du wc_bear
var float s_low   = na   // Low du wc_bear → base pour SL
var int   s_bar   = na
var int   s_state = 0    // 0=off | 1=attente escape | 2=prêt retest

if wc_bear
    s_lvl   := close
    s_low   := low
    s_bar   := bar_index
    s_state := 1

if s_state == 1 and close > s_lvl + atr * escape_mult
    s_state := 2

if s_state >= 1 and close < s_lvl - atr * retest_zone * 2.0
    s_state := 0

if s_state >= 1 and not na(s_bar) and (bar_index - s_bar) > max_bars
    s_state := 0

// ─── STATE MACHINE — RÉSISTANCE ───────────────────────────────────
var float r_lvl   = na
var float r_high  = na
var int   r_bar   = na
var int   r_state = 0

if wc_bull
    r_lvl   := close
    r_high  := high
    r_bar   := bar_index
    r_state := 1

if r_state == 1 and close < r_lvl - atr * escape_mult
    r_state := 2

if r_state >= 1 and close > r_lvl + atr * retest_zone * 2.0
    r_state := 0

if r_state >= 1 and not na(r_bar) and (bar_index - r_bar) > max_bars
    r_state := 0

// ─── COOLDOWN ─────────────────────────────────────────────────────
var int last_bar = na
can_trade = na(last_bar) or (bar_index - last_bar) >= cooldown_b

// ─── SIGNAUX ──────────────────────────────────────────────────────
buy_signal = s_state == 2 and sess_ok and t_bull and can_trade and
             low   <= s_lvl + atr * retest_zone and
             close >= s_lvl - atr * retest_zone * 0.5 and
             close > open

sell_signal = r_state == 2 and sess_ok and t_bear and can_trade and
              high  >= r_lvl - atr * retest_zone and
              close <= r_lvl + atr * retest_zone * 0.5 and
              close < open

if buy_signal
    s_state  := 0
    last_bar := bar_index

if sell_signal
    r_state  := 0
    last_bar := bar_index

// ─── SL / TP ──────────────────────────────────────────────────────
buy_sl  = buy_signal  ? s_low  - atr * sl_buf : na
buy_tp1 = buy_signal  ? close  + (close - buy_sl)   * tp1_rr : na
buy_tp2 = buy_signal  ? close  + (close - buy_sl)   * tp2_rr : na

sell_sl  = sell_signal ? r_high + atr * sl_buf : na
sell_tp1 = sell_signal ? close  - (sell_sl - close) * tp1_rr : na
sell_tp2 = sell_signal ? close  - (sell_sl - close) * tp2_rr : na

// ─── TRACKER DERNIER SIGNAL ───────────────────────────────────────
var float t_sl    = na
var float t_tp1   = na
var float t_tp2   = na
var float t_entry = na
var int   t_sbar  = na
var bool  t_buy   = true

if buy_signal
    t_sl    := buy_sl
    t_tp1   := buy_tp1
    t_tp2   := buy_tp2
    t_entry := close
    t_sbar  := bar_index
    t_buy   := true

if sell_signal
    t_sl    := sell_sl
    t_tp1   := sell_tp1
    t_tp2   := sell_tp2
    t_entry := close
    t_sbar  := bar_index
    t_buy   := false

show_lines = not na(t_sbar) and (bar_index - t_sbar) <= line_bars

// ─── VISUEL ───────────────────────────────────────────────────────
// Signaux
plotshape(buy_signal,  "BUY",  shape.labelup,   location.belowbar,
     color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.normal)
plotshape(sell_signal, "SELL", shape.labeldown, location.abovebar,
     color.new(color.red, 0),   text="SELL", textcolor=color.white, size=size.normal)

// Niveaux S/R actifs (fade = waiting, bright = ready)
plot(s_state >= 1 ? s_lvl : na, "Support",    color.new(color.lime, s_state == 2 ? 10 : 75), 1, plot.style_linebr)
plot(r_state >= 1 ? r_lvl : na, "Résistance", color.new(color.red,  r_state == 2 ? 10 : 75), 1, plot.style_linebr)

// SL / TP dernier signal
plot(show_lines ? t_sl    : na, "SL",    color.new(color.red,   0),  2, plot.style_linebr)
plot(show_lines ? t_tp1   : na, "TP1",   color.new(color.lime,  0),  2, plot.style_linebr)
plot(show_lines ? t_tp2   : na, "TP2",   color.new(color.green, 30), 1, plot.style_linebr)
plot(show_lines ? t_entry : na, "Entry", color.new(color.white, 60), 1, plot.style_linebr)

// SMA 200
plot(sma200, "SMA 200", color.new(color.yellow, 25), 2)

// ─── TABLEAU ──────────────────────────────────────────────────────
if barstate.islast
    var table tb = table.new(position.top_right, 2, 8,
         bgcolor=color.new(color.black, 65),
         border_color=color.new(color.gray, 55), border_width=1,
         frame_color=color.new(color.gray, 40), frame_width=1)

    table.cell(tb, 0, 0, "NOWICK", bgcolor=color.new(color.navy, 10), text_color=color.white,  text_size=size.small)
    table.cell(tb, 1, 0, "Brad.fx", bgcolor=color.new(color.navy, 10), text_color=color.yellow, text_size=size.small)

    table.cell(tb, 0, 1, "1H Trend", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 1, htf_bull ? "▲ BULL" : "▼ BEAR",
         text_color=htf_bull ? color.lime : color.red, text_size=size.small)

    table.cell(tb, 0, 2, "Session", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 2, sess_ok ? "ON" : "OFF",
         text_color=sess_ok ? color.lime : color.gray, text_size=size.small)

    table.cell(tb, 0, 3, "Support",    text_color=color.silver, text_size=size.small)
    s_txt = s_state == 2 ? "PRET" : s_state == 1 ? "escape..." : "—"
    s_c   = s_state == 2 ? color.lime : s_state == 1 ? color.yellow : color.gray
    table.cell(tb, 1, 3, s_txt, text_color=s_c, text_size=size.small)

    table.cell(tb, 0, 4, "Résistance", text_color=color.silver, text_size=size.small)
    r_txt = r_state == 2 ? "PRET" : r_state == 1 ? "escape..." : "—"
    r_c   = r_state == 2 ? color.red : r_state == 1 ? color.yellow : color.gray
    table.cell(tb, 1, 4, r_txt, text_color=r_c, text_size=size.small)

    table.cell(tb, 0, 5, "SL",  text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 5, not na(t_sl)  ? str.tostring(t_sl,  "#.#####") : "—",
         text_color=color.red, text_size=size.small)

    table.cell(tb, 0, 6, "TP1", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 6, not na(t_tp1) ? str.tostring(t_tp1, "#.#####") : "—",
         text_color=color.lime, text_size=size.small)

    table.cell(tb, 0, 7, "TP2", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 7, not na(t_tp2) ? str.tostring(t_tp2, "#.#####") : "—",
         text_color=color.green, text_size=size.small)

// ─── ALERTES ──────────────────────────────────────────────────────
alertcondition(buy_signal,  "Nowick BUY",  "Nowick BUY — retest support confirmé")
alertcondition(sell_signal, "Nowick SELL", "Nowick SELL — retest résistance confirmé")
