//@version=6
indicator("Brad.fx — EMA Pullback", overlay=true, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════
// STRATÉGIE : EMA20 Pullback + Confirmation Nowick/Engulfing
//
// LOGIQUE :
//   1. Trend  → price > EMA200 ET EMA20 > EMA50  (bull)
//              price < EMA200 ET EMA20 < EMA50  (bear)
//   2. Zone   → pullback jusqu'à l'EMA20 (low touche l'EMA20)
//   3. Confirm→ bougie quasi-wickless OU engulfing dans la zone
//   4. Filtre → session Londres/NY (07-17 UTC), max 1 trade/jour
//   5. SL     → sous le swing low du pullback (EMA50) - buffer ATR
//   6. TP     → 1:2 RR
// ═══════════════════════════════════════════════════════════════════

// ─── INPUTS ───────────────────────────────────────────────────────
show_emas = input.bool(false, "Afficher EMAs")
use_sess  = input.bool(true,  "Session 07-17 UTC")

// ─── EMAs ─────────────────────────────────────────────────────────
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

plot(show_emas ? ema20  : na, "EMA 20",  color=color.new(color.yellow, 0), linewidth=1)
plot(show_emas ? ema50  : na, "EMA 50",  color=color.new(color.orange, 0), linewidth=1)
plot(show_emas ? ema200 : na, "EMA 200", color=color.new(color.white,  0), linewidth=2)

// ─── BASE ─────────────────────────────────────────────────────────
atr     = ta.atr(14)
body    = math.abs(close - open)
dn_wick = math.min(open, close) - low
up_wick = high - math.max(open, close)

// ─── TREND CONFIRMÉ (stack EMA) ───────────────────────────────────
bull_trend = close > ema200 and ema20 > ema50
bear_trend = close < ema200 and ema20 < ema50

// ─── ZONE PULLBACK SUR EMA20 ──────────────────────────────────────
// Bull : low touche l'EMA20 depuis le haut, close repasse au-dessus
// Bear : high touche l'EMA20 depuis le bas, close repasse en-dessous
zone_bull = low  <= ema20 + atr * 0.15 and close >= ema20
zone_bear = high >= ema20 - atr * 0.15 and close <= ema20

// ─── BOUGIE DE CONFIRMATION ───────────────────────────────────────
// Nowick : mèche côté rejection < 15% du corps + corps fort (≥0.5 ATR)
// Engulfing : close englobe le corps de la barre précédente
strong = body >= atr * 0.5

nowick_bull = close > open and dn_wick <= body * 0.15 and strong
nowick_bear = close < open and up_wick <= body * 0.15 and strong
engulf_bull = close > open and close > open[1] and open < close[1] and strong
engulf_bear = close < open and close < open[1] and open > close[1] and strong

confirm_bull = nowick_bull or engulf_bull
confirm_bear = nowick_bear or engulf_bear

// ─── SIGNAL BRUT ──────────────────────────────────────────────────
sess_ok  = not use_sess or (hour(time, "UTC") >= 7 and hour(time, "UTC") < 17)
raw_buy  = bull_trend and zone_bull and confirm_bull and sess_ok
raw_sell = bear_trend and zone_bear and confirm_bear and sess_ok

// ─── MAX 1 SIGNAL PAR JOUR ────────────────────────────────────────
var int last_date = 0
cur_date = year * 10000 + month * 100 + dayofmonth
no_trade_today = cur_date != last_date

buy_sig  = raw_buy  and no_trade_today
sell_sig = raw_sell and no_trade_today

if buy_sig or sell_sig
    last_date := cur_date

// ─── SL / TP ──────────────────────────────────────────────────────
// SL : sous le plus bas entre EMA50 et le low courant - buffer
// TP : 2× le risque (1:2 RR)
buy_sl    = buy_sig  ? math.min(ema50, low)  - atr * 0.3 : na
sell_sl   = sell_sig ? math.max(ema50, high) + atr * 0.3 : na
buy_risk  = not na(buy_sl)  ? close - buy_sl  : na
sell_risk = not na(sell_sl) ? sell_sl - close : na
buy_tp    = not na(buy_risk)  ? close + buy_risk  * 2.0 : na
sell_tp   = not na(sell_risk) ? close - sell_risk * 2.0 : na

// ─── LABELS AVEC TP/SL EN PRIX (pas de lignes) ────────────────────
if buy_sig
    _tp  = str.tostring(buy_tp,  format.mintick)
    _sl  = str.tostring(buy_sl,  format.mintick)
    _txt = "BUY\nTP → " + _tp + "\nSL → " + _sl
    label.new(bar_index, low, _txt,
              yloc=yloc.price,
              color=color.new(color.green, 0),
              textcolor=color.white,
              style=label.style_label_up,
              size=size.normal)

if sell_sig
    _tp  = str.tostring(sell_tp, format.mintick)
    _sl  = str.tostring(sell_sl, format.mintick)
    _txt = "SELL\nTP → " + _tp + "\nSL → " + _sl
    label.new(bar_index, high, _txt,
              yloc=yloc.price,
              color=color.new(color.red, 0),
              textcolor=color.white,
              style=label.style_label_down,
              size=size.normal)

// ─── ALERTES ──────────────────────────────────────────────────────
alertcondition(buy_sig,  "BUY  — EMA20 Pullback", "Brad.fx BUY  — EMA20 Pullback confirmé")
alertcondition(sell_sig, "SELL — EMA20 Pullback", "Brad.fx SELL — EMA20 Pullback confirmé")
