// ============================================================================
// NOWICK INDICATOR PRO - Brad.fx Optimized (INDICATOR VERSION)
// Version: 3.0 | M15 Forex | Target: 4-8 trades/week | 60%+ WR
//
// CHANGES v3.0:
//   - Zero line clutter: TP/SL computed in background, shown only via
//     label tooltip + table. No more line.new() accumulation.
//   - Cooldown filter: min bars between signals (prevents cluster signals)
//   - Swing structure filter: signal must fire AT a swing extreme
//   - RSI tightened to 40/60 defaults (was 50/50)
//   - Session filter fixed: hour-based UTC check (works in replay mode)
//   - ADX trend strength filter added
//   - Only 1 active signal's levels shown via plot() (not stacked lines)
// ============================================================================

//@version=5
indicator("Nowick Indicator PRO v3.0", overlay=true, max_bars_back=500)

// ============================================================================
// INPUTS
// ============================================================================

grp1 = "🕯️ Wickless Detection"
wick_max_pct  = input.float(5.0, "Max Wick % of Body",      minval=0.0, maxval=30.0, step=0.5, group=grp1,
                 tooltip="0 = purely wickless only. Increase if too few signals.")
min_body_atr  = input.float(0.5, "Min Body (x ATR)",         minval=0.1, maxval=2.0,  step=0.1, group=grp1,
                 tooltip="Filters tiny doji candles. 0.5 = body must be at least 50% of ATR.")
atr_len       = input.int(14,   "ATR Length",                minval=5, maxval=50,              group=grp1)

grp2 = "📈 HTF Trend Filter"
use_htf       = input.bool(true, "Enable HTF Filter",        group=grp2)
htf_tf        = input.timeframe("60", "HTF Timeframe",       group=grp2)
htf_fast      = input.int(20,   "HTF Fast EMA",              minval=5,  maxval=100,             group=grp2)
htf_slow      = input.int(50,   "HTF Slow EMA",              minval=20, maxval=200,             group=grp2)

grp3 = "📊 RSI Filter"
use_rsi       = input.bool(true, "Enable RSI Filter",        group=grp3)
rsi_len       = input.int(14,   "RSI Length",                group=grp3)
rsi_buy_max   = input.int(40,   "Max RSI for BUY",           minval=20, maxval=60, group=grp3,
                 tooltip="Only BUY when RSI < this. 40 = must be below midpoint & leaning oversold.")
rsi_sell_min  = input.int(60,   "Min RSI for SELL",          minval=40, maxval=80, group=grp3)
rsi_ext_buy   = input.int(30,   "Strong BUY (RSI <)",        minval=10, maxval=45, group=grp3)
rsi_ext_sell  = input.int(70,   "Strong SELL (RSI >)",       minval=55, maxval=90, group=grp3)

grp4 = "💪 Trend Strength (ADX)"
use_adx       = input.bool(true,  "Enable ADX Filter",       group=grp4,
                 tooltip="Only trade when market is trending. Avoids choppy ranging periods.")
adx_len       = input.int(14,    "ADX Length",               group=grp4)
adx_min       = input.int(20,    "Min ADX Value",            minval=10, maxval=40, group=grp4,
                 tooltip="20 = light trend. 25 = confirmed trend. Raise to reduce signals further.")

grp5 = "🔲 Swing Structure Filter"
use_swing     = input.bool(true,  "Signal Must Be at Swing Extreme", group=grp5,
                 tooltip="BUY only when price is at/near a recent swing low. Eliminates mid-range signals.")
swing_bars    = input.int(10,    "Swing Lookback (bars)",    minval=3, maxval=30, group=grp5)
swing_tol_atr = input.float(0.5, "Swing Tolerance (x ATR)", minval=0.1, maxval=2.0, step=0.1, group=grp5,
                 tooltip="How close to the swing extreme the signal must be.")

grp6 = "⏱️ Cooldown (prevents clusters)"
cooldown_bars = input.int(20, "Min Bars Between Signals",    minval=4, maxval=100, group=grp6,
                 tooltip="20 bars = 5 hours on M15. Prevents 3 BUY signals in a row. For 4-8/week use 16-24.")

grp7 = "🕐 Session Filter"
use_session   = input.bool(true, "Enable Session Filter",    group=grp7)
sess_start_h  = input.int(7,  "Session Start (UTC hour)",   minval=0, maxval=23, group=grp7,
                 tooltip="London opens at 7 UTC. Use 7 to avoid Asian session false moves.")
sess_end_h    = input.int(17, "Session End (UTC hour)",      minval=1, maxval=23, group=grp7)

grp8 = "📦 Volume Filter"
use_vol       = input.bool(true, "Enable Volume Filter",     group=grp8)
vol_ma_len    = input.int(20,   "Volume MA Length",          group=grp8)
vol_min_mult  = input.float(0.8, "Min Volume (x MA)",        minval=0.3, maxval=3.0, step=0.1, group=grp8,
                 tooltip="0.8 = 80% of average volume OK. Lowered from 1.0 so session filter is the main gate.")

grp9 = "🎯 SL / TP"
sl_atr_mult   = input.float(1.2, "SL ATR Multiplier",       minval=0.5, maxval=4.0, step=0.1, group=grp9)
sl_buffer     = input.float(0.00015, "SL Min Buffer",        minval=0.0, step=0.00005,         group=grp9)
tp1_rr        = input.float(1.5, "TP1 Risk:Reward",         minval=1.0, maxval=8.0,  step=0.1, group=grp9)
tp2_rr        = input.float(2.5, "TP2 Risk:Reward",         minval=1.0, maxval=10.0, step=0.1, group=grp9)
show_tp_bars  = input.int(0,    "Show TP/SL lines for N bars (0=off)", minval=0, maxval=100,   group=grp9,
                 tooltip="0 = no lines on chart (cleanest). Set to 20-30 to show levels after signal.")

grp10 = "🎨 Display"
show_sma200   = input.bool(true,  "Show SMA 200",            group=grp10)
show_htf_emas = input.bool(false, "Show HTF EMAs",           group=grp10,
                 tooltip="Disabled by default to reduce visual clutter.")
show_bg       = input.bool(true,  "Show Background Zone",    group=grp10)
show_table    = input.bool(true,  "Show Info Table",         group=grp10)
show_raw_wl   = input.bool(false, "Show All Raw Wickless",   group=grp10,
                 tooltip="Show ALL wickless candles regardless of filters (dots). Off = cleaner chart.")

// ============================================================================
// CALCULATIONS
// ============================================================================
atr    = ta.atr(atr_len)
sma200 = ta.sma(close, 200)
rsi    = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_ma_len)

// ADX
[adx_dip, adx_dim, adx_val] = ta.dmi(adx_len, adx_len)

// HTF EMAs
[htf_ema_f, htf_ema_s] = request.security(syminfo.tickerid, htf_tf,
     [ta.ema(close, htf_fast), ta.ema(close, htf_slow)],
     lookahead=barmerge.lookahead_off)
htf_bull = htf_ema_f > htf_ema_s
htf_bear = htf_ema_f < htf_ema_s

// Candle anatomy
body       = math.abs(close - open)
upper_wick = high - math.max(open, close)
lower_wick = math.min(open, close) - low
is_bull    = close > open
is_bear    = close < open

// Wickless detection
wick_thresh   = body * (wick_max_pct / 100.0)
min_body_val  = atr * min_body_atr
wickless_bull = is_bull and upper_wick <= wick_thresh and body >= min_body_val
wickless_bear = is_bear and lower_wick <= wick_thresh and body >= min_body_val

// ============================================================================
// FILTERS
// ============================================================================

// Session: hour-based UTC (robust in replay mode, avoids session string issues)
bar_hour   = hour(time, "UTC")
session_ok = not use_session or (bar_hour >= sess_start_h and bar_hour < sess_end_h)

// Volume
vol_ok = not use_vol or (volume >= vol_ma * vol_min_mult)

// RSI
rsi_ok_buy  = not use_rsi or rsi <= rsi_buy_max
rsi_ok_sell = not use_rsi or rsi >= rsi_sell_min

// ADX
adx_ok = not use_adx or adx_val >= adx_min

// HTF
htf_ok_buy  = not use_htf or htf_bull
htf_ok_sell = not use_htf or htf_bear

// Swing structure: signal must be at or very near a recent extreme
swing_low_level  = ta.lowest(low,  swing_bars)
swing_high_level = ta.highest(high, swing_bars)
near_swing_low   = not use_swing or (low  <= swing_low_level  + atr * swing_tol_atr)
near_swing_high  = not use_swing or (high >= swing_high_level - atr * swing_tol_atr)

// Cooldown: prevent clustered signals
var int last_buy_bar  = -1000
var int last_sell_bar = -1000
buy_cooldown_ok  = (bar_index - last_buy_bar)  >= cooldown_bars
sell_cooldown_ok = (bar_index - last_sell_bar) >= cooldown_bars

// ============================================================================
// SIGNAL GENERATION
// ============================================================================
buy_raw = wickless_bear and htf_ok_buy  and rsi_ok_buy  and vol_ok and session_ok and adx_ok and near_swing_low
sel_raw = wickless_bull and htf_ok_sell and rsi_ok_sell and vol_ok and session_ok and adx_ok and near_swing_high

buy_signal  = buy_raw and buy_cooldown_ok
sell_signal = sel_raw and sell_cooldown_ok

strong_buy  = buy_signal  and rsi <= rsi_ext_buy
strong_sell = sell_signal and rsi >= rsi_ext_sell

// Update cooldown counters
if buy_signal
    last_buy_bar  := bar_index
if sell_signal
    last_sell_bar := bar_index

// ============================================================================
// SL / TP — computed silently, shown via tooltip + optional chart lines
// ============================================================================
buy_sl   = buy_signal ? math.min(low  - sl_buffer, close - atr * sl_atr_mult) : na
buy_risk = close - nz(buy_sl)
buy_tp1  = buy_signal ? close + buy_risk * tp1_rr : na
buy_tp2  = buy_signal ? close + buy_risk * (strong_buy  ? tp2_rr + 0.5 : tp2_rr) : na

sel_sl   = sell_signal ? math.max(high + sl_buffer, close + atr * sl_atr_mult) : na
sel_risk = nz(sel_sl) - close
sel_tp1  = sell_signal ? close - sel_risk * tp1_rr : na
sel_tp2  = sell_signal ? close - sel_risk * (strong_sell ? tp2_rr + 0.5 : tp2_rr) : na

// Track last signal levels for optional chart display
var float track_sl   = na
var float track_tp1  = na
var float track_tp2  = na
var float track_entry= na
var int   track_bar  = na
var bool  track_is_buy = false

if buy_signal
    track_sl    := buy_sl
    track_tp1   := buy_tp1
    track_tp2   := buy_tp2
    track_entry := close
    track_bar   := bar_index
    track_is_buy := true

if sell_signal
    track_sl    := sel_sl
    track_tp1   := sel_tp1
    track_tp2   := sel_tp2
    track_entry := close
    track_bar   := bar_index
    track_is_buy := false

// Show lines only for N bars after signal (0 = completely off)
show_levels = show_tp_bars > 0 and not na(track_bar) and (bar_index - track_bar) <= show_tp_bars

// ============================================================================
// SIGNAL LABELS (with tooltip = TP/SL info in background)
// ============================================================================
if buy_signal
    rr_effective = strong_buy ? tp2_rr + 0.5 : tp1_rr
    tip = "ENTRY: " + str.tostring(close, "#.#####") +
          "\nSL:    " + str.tostring(buy_sl, "#.#####") +
          "  (risk: " + str.tostring(math.round((close - buy_sl) / syminfo.mintick, 0)) + " pips)" +
          "\nTP1:   " + str.tostring(buy_tp1, "#.#####") + "  [RR 1:" + str.tostring(tp1_rr) + "]" +
          "\nTP2:   " + str.tostring(buy_tp2, "#.#####") + "  [RR 1:" + str.tostring(rr_effective) + "]" +
          "\nRSI:   " + str.tostring(math.round(rsi, 1)) +
          "\nADX:   " + str.tostring(math.round(adx_val, 1)) +
          (strong_buy ? "\n⭐ STRONG SETUP" : "")
    lbl_color = strong_buy ? color.lime : color.new(color.green, 10)
    lbl_text  = strong_buy ? "BUY ★" : "BUY"
    label.new(bar_index, low, text=lbl_text, tooltip=tip,
              color=lbl_color, textcolor=color.black,
              style=label.style_label_up, size=strong_buy ? size.normal : size.small)

if sell_signal
    rr_effective = strong_sell ? tp2_rr + 0.5 : tp1_rr
    tip = "ENTRY: " + str.tostring(close, "#.#####") +
          "\nSL:    " + str.tostring(sel_sl, "#.#####") +
          "  (risk: " + str.tostring(math.round((sel_sl - close) / syminfo.mintick, 0)) + " pips)" +
          "\nTP1:   " + str.tostring(sel_tp1, "#.#####") + "  [RR 1:" + str.tostring(tp1_rr) + "]" +
          "\nTP2:   " + str.tostring(sel_tp2, "#.#####") + "  [RR 1:" + str.tostring(rr_effective) + "]" +
          "\nRSI:   " + str.tostring(math.round(rsi, 1)) +
          "\nADX:   " + str.tostring(math.round(adx_val, 1)) +
          (strong_sell ? "\n⭐ STRONG SETUP" : "")
    lbl_color = strong_sell ? color.maroon : color.new(color.red, 10)
    label.new(bar_index, high, text=strong_sell ? "SELL ★" : "SELL", tooltip=tip,
              color=lbl_color, textcolor=color.white,
              style=label.style_label_down, size=strong_sell ? size.normal : size.small)

// ============================================================================
// CHART LINES — only current signal, only if show_tp_bars > 0
// ============================================================================
// Single set of 4 plot() lines for the LAST signal only. No accumulation.
plot(show_levels ? track_sl   : na, "SL",    color.new(color.red,   15), 2, plot.style_linebr)
plot(show_levels ? track_tp1  : na, "TP1",   color.new(color.lime,  20), 2, plot.style_linebr)
plot(show_levels ? track_tp2  : na, "TP2",   color.new(color.green, 15), 1, plot.style_linebr)
plot(show_levels ? track_entry: na, "Entry", color.new(color.white, 60), 1, plot.style_linebr)

// ============================================================================
// OPTIONAL: raw wickless dots (disabled by default for clean chart)
// ============================================================================
plotshape(show_raw_wl and wickless_bull and not sell_signal, "WL Bull",
          shape.circle, location.belowbar, color.new(color.teal,   75), size=size.tiny)
plotshape(show_raw_wl and wickless_bear and not buy_signal,  "WL Bear",
          shape.circle, location.abovebar, color.new(color.orange, 75), size=size.tiny)

// ============================================================================
// MOVING AVERAGES
// ============================================================================
plot(show_sma200   ? sma200    : na, "SMA 200",       color.new(color.yellow, 20), 2)
plot(show_htf_emas ? htf_ema_f : na, "HTF EMA Fast",  color.new(color.aqua,   40), 1, plot.style_stepline)
plot(show_htf_emas ? htf_ema_s : na, "HTF EMA Slow",  color.new(color.purple, 40), 1, plot.style_stepline)

// ============================================================================
// BACKGROUND — subtle zone highlight (buy or sell conditions met)
// ============================================================================
buy_zone  = session_ok and rsi_ok_buy  and htf_ok_buy  and adx_ok
sell_zone = session_ok and rsi_ok_sell and htf_ok_sell and adx_ok
bgcolor(show_bg and buy_zone  ? color.new(color.green, 96) : na, title="Buy Zone")
bgcolor(show_bg and sell_zone ? color.new(color.red,   96) : na, title="Sell Zone")

// ============================================================================
// NOWICK SIGNAL PANE (bottom, mirrors original)
// ============================================================================
var float nw_hi = na
var float nw_lo = na
if wickless_bull
    nw_hi := close
    nw_lo := open
if wickless_bear
    nw_hi := open
    nw_lo := close
plot(nw_hi, "NW Hi", color.new(color.orange, 40), display=display.pane)
plot(nw_lo, "NW Lo", color.new(color.teal,   40), display=display.pane)

// ============================================================================
// INFO TABLE
// ============================================================================
if show_table and barstate.islast
    var table t = table.new(position.top_right, 2, 14,
         bgcolor=color.new(color.black, 78),
         border_color=color.new(color.gray, 60), border_width=1,
         frame_color=color.new(color.blue, 40), frame_width=1)

    // Header
    table.cell(t, 0, 0, "NOWICK PRO", text_color=color.white,  text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.cell(t, 1, 0, "v3.0",       text_color=color.yellow, text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)

    // Trend
    table.cell(t, 0, 1, "HTF Trend",  text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, htf_bull ? "▲ BULL" : "▼ BEAR",
               text_color=htf_bull ? color.lime : color.red, text_size=size.small)

    // RSI
    table.cell(t, 0, 2, "RSI",        text_color=color.white, text_size=size.small)
    rsi_c = rsi >= rsi_ext_sell ? color.red : rsi <= rsi_ext_buy ? color.lime :
            rsi_ok_buy or rsi_ok_sell ? color.yellow : color.gray
    table.cell(t, 1, 2, str.tostring(math.round(rsi, 1)),
               text_color=rsi_c, text_size=size.small)

    // ADX
    table.cell(t, 0, 3, "ADX",        text_color=color.white, text_size=size.small)
    adx_c = adx_val >= adx_min ? color.lime : color.gray
    table.cell(t, 1, 3, str.tostring(math.round(adx_val, 1)) + (adx_ok ? " ✓" : " ✗"),
               text_color=adx_c, text_size=size.small)

    // Session
    table.cell(t, 0, 4, "Session",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, session_ok ? "✓ ON (" + str.tostring(bar_hour) + "h)" : "✗ OFF",
               text_color=session_ok ? color.lime : color.gray, text_size=size.small)

    // Volume
    table.cell(t, 0, 5, "Volume",     text_color=color.white, text_size=size.small)
    vol_r = math.round(volume / vol_ma, 2)
    table.cell(t, 1, 5, str.tostring(vol_r) + "x" + (vol_ok ? " ✓" : " ✗"),
               text_color=vol_ok ? color.lime : color.gray, text_size=size.small)

    // ATR
    table.cell(t, 0, 6, "ATR",        text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, str.tostring(math.round(atr, 5)), text_color=color.white, text_size=size.small)

    // Cooldown
    table.cell(t, 0, 7, "Cooldown",   text_color=color.white, text_size=size.small)
    bars_since = math.min(bar_index - last_buy_bar, bar_index - last_sell_bar)
    cooldown_pct = math.min(math.round(bars_since / cooldown_bars * 100), 100)
    table.cell(t, 1, 7, str.tostring(cooldown_pct) + "% ready",
               text_color=cooldown_pct >= 100 ? color.lime : color.yellow, text_size=size.small)

    // Separator
    table.cell(t, 0, 8, "─────────",  text_color=color.new(color.gray, 60), text_size=size.tiny)
    table.cell(t, 1, 8, "─────────",  text_color=color.new(color.gray, 60), text_size=size.tiny)

    // Last signal TP/SL (calculated in background, shown here)
    table.cell(t, 0, 9,  "Last Entry", text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 9,  not na(track_entry) ? str.tostring(track_entry, "#.#####") : "—",
               text_color=color.white, text_size=size.small)

    table.cell(t, 0, 10, "Last SL",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 10, not na(track_sl) ? str.tostring(track_sl, "#.#####") : "—",
               text_color=color.red, text_size=size.small)

    table.cell(t, 0, 11, "Last TP1",  text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 11, not na(track_tp1) ? str.tostring(track_tp1, "#.#####") : "—",
               text_color=color.lime, text_size=size.small)

    table.cell(t, 0, 12, "Last TP2",  text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 12, not na(track_tp2) ? str.tostring(track_tp2, "#.#####") : "—",
               text_color=color.green, text_size=size.small)

    // Readiness
    table.cell(t, 0, 13, "BUY/SELL?", text_color=color.white,  text_size=size.small)
    ready_buy  = htf_ok_buy  and rsi_ok_buy  and session_ok and vol_ok and adx_ok and buy_cooldown_ok
    ready_sell = htf_ok_sell and rsi_ok_sell and session_ok and vol_ok and adx_ok and sell_cooldown_ok
    ready_txt  = ready_buy ? "BUY ✓" : ready_sell ? "SELL ✓" : "Waiting..."
    ready_c    = ready_buy ? color.lime : ready_sell ? color.red : color.gray
    table.cell(t, 1, 13, ready_txt, text_color=ready_c, text_size=size.small)
