//@version=6
indicator("Nowick PRO — Brad.fx", overlay=true, max_bars_back=500)

// ══════════════════════════════════════════════════════════════════
//  LOGIQUE RÉELLE Brad.fx — Nowick Retest
//
//  1. Wickless Bear (close = low)  → crée un SUPPORT
//     Wickless Bull (close = high) → crée une RÉSISTANCE
//
//  2. Le prix S'ÉCHAPPE du niveau (confirme l'importance)
//
//  3. Le prix RETESTE le niveau → ENTRÉE sur bougie de confirmation
//     BUY  : retest support + fermeture haussière au-dessus
//     SELL : retest résistance + fermeture baissière en-dessous
//
//  SL  : derrière l'extrême de la wickless candle + buffer ATR
//  TP1 : 1.5 RR  |  TP2 : 2.5 RR
// ══════════════════════════════════════════════════════════════════

// ─── INPUTS ───────────────────────────────────────────────────────
g1 = "Wickless Detection"
wick_max     = input.float(3.0,  "Wick max (% du body)",       minval=0,   maxval=15,  step=0.5, group=g1, tooltip="0 = parfaitement wickless. 3 = wick autorisé jusqu'à 3% du body.")
min_body_atr = input.float(0.5,  "Body min (x ATR)",           minval=0.2, maxval=2.0, step=0.1, group=g1, tooltip="Filtre les petites bougies sans conviction.")
atr_len      = input.int(14,     "Longueur ATR",               minval=5,   maxval=50,            group=g1)

g2 = "Retest Logic"
escape_mult  = input.float(0.8,  "Escape min (x ATR)",         minval=0.3, maxval=3.0, step=0.1, group=g2, tooltip="Distance que le prix doit parcourir avant d'être prêt pour retest.")
retest_zone  = input.float(0.3,  "Zone retest (x ATR)",        minval=0.1, maxval=1.0, step=0.05, group=g2, tooltip="Tolérance autour du niveau pour déclencher le retest.")
max_bars     = input.int(50,     "Expiry du niveau (barres)",  minval=10,  maxval=200,            group=g2, tooltip="Niveau invalidé après N barres sans retest.")
cooldown_b   = input.int(10,     "Cooldown (barres min)",      minval=3,   maxval=50,             group=g2, tooltip="Barres minimum entre deux signaux.")

g3 = "Tendance HTF"
use_htf      = input.bool(true,  "Filtre tendance HTF",        group=g3)
htf_tf       = input.timeframe("60", "Timeframe HTF",          group=g3)
ema_fast     = input.int(20,     "EMA rapide",                 group=g3)
ema_slow     = input.int(50,     "EMA lente",                  group=g3)

g4 = "Session (UTC)"
use_sess     = input.bool(true,  "Filtre session",             group=g4)
sess_start   = input.int(7,      "Début (heure UTC)",          minval=0,   maxval=23, group=g4)
sess_end     = input.int(17,     "Fin (heure UTC)",            minval=1,   maxval=23, group=g4)

g5 = "SL / TP"
sl_buf       = input.float(1.0,  "Buffer SL (x ATR)",         minval=0.3, maxval=3.0, step=0.1, group=g5)
tp1_rr       = input.float(1.5,  "TP1 (RR)",                  minval=1.0, maxval=5.0, step=0.1, group=g5)
tp2_rr       = input.float(2.5,  "TP2 (RR)",                  minval=1.0, maxval=8.0, step=0.1, group=g5)
line_bars    = input.int(40,     "Lignes SL/TP visibles (N barres)", minval=5, maxval=150,        group=g5)

g6 = "Affichage"
show_sma     = input.bool(true,  "SMA 200",                   group=g6)
show_levels  = input.bool(true,  "Niveaux S/R actifs",        group=g6)
show_table   = input.bool(true,  "Tableau info",              group=g6)

// ─── BASE ─────────────────────────────────────────────────────────
atr    = ta.atr(atr_len)
sma200 = ta.sma(close, 200)

[htf_ef, htf_es] = request.security(syminfo.tickerid, htf_tf,
     [ta.ema(close, ema_fast), ta.ema(close, ema_slow)],
     lookahead=barmerge.lookahead_off)

htf_bull = htf_ef > htf_es
htf_bear = htf_ef < htf_es

bar_h    = hour(time, "UTC")
sess_ok  = not use_sess or (bar_h >= sess_start and bar_h < sess_end)
t_bull   = not use_htf or htf_bull
t_bear   = not use_htf or htf_bear

// ─── DÉTECTION WICKLESS ───────────────────────────────────────────
body       = math.abs(close - open)
up_wick    = high - math.max(open, close)
dn_wick    = math.min(open, close) - low
thresh     = body * (wick_max / 100.0)
big_enough = body >= atr * min_body_atr

// Wickless Bear : bearish, close ≈ low → SUPPORT (buy sur retest)
wc_bear = close < open and dn_wick <= thresh and big_enough
// Wickless Bull : bullish, close ≈ high → RÉSISTANCE (sell sur retest)
wc_bull = close > open and up_wick <= thresh and big_enough

// ─── STATE MACHINE — SUPPORT ──────────────────────────────────────
// 0 = inactif | 1 = niveau créé, attente escape | 2 = prêt pour retest
var float s_lvl   = na
var float s_low   = na
var int   s_bar   = na
var int   s_state = 0

if wc_bear
    s_lvl   := close
    s_low   := low
    s_bar   := bar_index
    s_state := 1

// Escape : prix monte au-dessus du niveau
if s_state == 1 and close > s_lvl + atr * escape_mult
    s_state := 2

// Cassure : prix ferme clairement sous le niveau → invalide
if s_state >= 1 and close < s_lvl - atr * retest_zone * 2.0
    s_state := 0

// Expiry
if s_state >= 1 and not na(s_bar) and (bar_index - s_bar) > max_bars
    s_state := 0

// ─── STATE MACHINE — RÉSISTANCE ───────────────────────────────────
var float r_lvl   = na
var float r_high  = na
var int   r_bar   = na
var int   r_state = 0

if wc_bull
    r_lvl   := close
    r_high  := high
    r_bar   := bar_index
    r_state := 1

// Escape : prix descend sous le niveau
if r_state == 1 and close < r_lvl - atr * escape_mult
    r_state := 2

// Cassure : prix ferme clairement au-dessus → invalide
if r_state >= 1 and close > r_lvl + atr * retest_zone * 2.0
    r_state := 0

// Expiry
if r_state >= 1 and not na(r_bar) and (bar_index - r_bar) > max_bars
    r_state := 0

// ─── COOLDOWN ─────────────────────────────────────────────────────
var int last_bar = na
can_trade = na(last_bar) or (bar_index - last_bar) >= cooldown_b

// ─── SIGNAUX ──────────────────────────────────────────────────────
// BUY : retest support confirmé par bougie haussière
buy_signal = s_state == 2 and sess_ok and t_bull and can_trade and
             low   <= s_lvl + atr * retest_zone and
             close >= s_lvl - atr * retest_zone * 0.5 and
             close > open

// SELL : retest résistance confirmé par bougie baissière
sell_signal = r_state == 2 and sess_ok and t_bear and can_trade and
              high  >= r_lvl - atr * retest_zone and
              close <= r_lvl + atr * retest_zone * 0.5 and
              close < open

// Invalide le niveau après signal (1 trade par niveau)
if buy_signal
    s_state  := 0
    last_bar := bar_index

if sell_signal
    r_state  := 0
    last_bar := bar_index

// ─── SL / TP ──────────────────────────────────────────────────────
buy_sl  = buy_signal  ? s_low  - atr * sl_buf : na
buy_tp1 = buy_signal  ? close  + (close - buy_sl)   * tp1_rr : na
buy_tp2 = buy_signal  ? close  + (close - buy_sl)   * tp2_rr : na

sell_sl  = sell_signal ? r_high + atr * sl_buf : na
sell_tp1 = sell_signal ? close  - (sell_sl - close) * tp1_rr : na
sell_tp2 = sell_signal ? close  - (sell_sl - close) * tp2_rr : na

// ─── TRACKER DERNIER SIGNAL ───────────────────────────────────────
var float t_sl    = na
var float t_tp1   = na
var float t_tp2   = na
var float t_entry = na
var int   t_sbar  = na
var bool  t_buy   = true

if buy_signal
    t_sl    := buy_sl
    t_tp1   := buy_tp1
    t_tp2   := buy_tp2
    t_entry := close
    t_sbar  := bar_index
    t_buy   := true

if sell_signal
    t_sl    := sell_sl
    t_tp1   := sell_tp1
    t_tp2   := sell_tp2
    t_entry := close
    t_sbar  := bar_index
    t_buy   := false

show_lines = not na(t_sbar) and (bar_index - t_sbar) <= line_bars

// ─── PLOT SIGNAUX ─────────────────────────────────────────────────
plotshape(buy_signal,  "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.normal)
plotshape(sell_signal, "SELL", shape.labeldown, location.abovebar, color.new(color.red,   0), text="SELL", textcolor=color.white, size=size.normal)

// ─── NIVEAUX S/R ACTIFS ───────────────────────────────────────────
plot(show_levels and s_state >= 1 ? s_lvl : na, "Support",    color.new(color.lime, s_state == 2 ? 15 : 70), 2, plot.style_linebr)
plot(show_levels and r_state >= 1 ? r_lvl : na, "Résistance", color.new(color.red,  r_state == 2 ? 15 : 70), 2, plot.style_linebr)

// ─── SL / TP (dernier signal seulement, N barres) ─────────────────
plot(show_lines ? t_entry : na, "Entry", color.new(color.white, 45), 1, plot.style_linebr)
plot(show_lines ? t_sl    : na, "SL",    color.new(color.red,    5), 2, plot.style_linebr)
plot(show_lines ? t_tp1   : na, "TP1",   color.new(color.lime,   5), 2, plot.style_linebr)
plot(show_lines ? t_tp2   : na, "TP2",   color.new(color.green, 20), 1, plot.style_linebr)

// SMA 200
plot(show_sma ? sma200 : na, "SMA 200", color.new(color.yellow, 20), 2)

// ─── TABLEAU ──────────────────────────────────────────────────────
if show_table and barstate.islast
    var table tb = table.new(position.top_right, 2, 9,
         bgcolor=color.new(color.black, 70),
         border_color=color.new(color.gray, 60), border_width=1)

    table.cell(tb, 0, 0, "NOWICK PRO",  bgcolor=color.new(color.navy, 15), text_color=color.white,  text_size=size.small)
    table.cell(tb, 1, 0, "Brad.fx",     bgcolor=color.new(color.navy, 15), text_color=color.yellow, text_size=size.small)

    table.cell(tb, 0, 1, "HTF Trend",   text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 1, htf_bull ? "▲ BULL" : "▼ BEAR", text_color=htf_bull ? color.lime : color.red, text_size=size.small)

    table.cell(tb, 0, 2, "Session",     text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 2, sess_ok ? "ON" : "OFF", text_color=sess_ok ? color.lime : color.gray, text_size=size.small)

    table.cell(tb, 0, 3, "Support",     text_color=color.white, text_size=size.small)
    s_txt = s_state == 2 ? "PRET " + str.tostring(s_lvl, "#.#####") : s_state == 1 ? "Attente..." : "—"
    s_c   = s_state == 2 ? color.lime : s_state == 1 ? color.yellow : color.gray
    table.cell(tb, 1, 3, s_txt, text_color=s_c, text_size=size.small)

    table.cell(tb, 0, 4, "Résistance",  text_color=color.white, text_size=size.small)
    r_txt = r_state == 2 ? "PRET " + str.tostring(r_lvl, "#.#####") : r_state == 1 ? "Attente..." : "—"
    r_c   = r_state == 2 ? color.red : r_state == 1 ? color.yellow : color.gray
    table.cell(tb, 1, 4, r_txt, text_color=r_c, text_size=size.small)

    table.cell(tb, 0, 5, "Entry",       text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 5, not na(t_entry) ? str.tostring(t_entry, "#.#####") : "—", text_color=color.white, text_size=size.small)

    table.cell(tb, 0, 6, "SL",          text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 6, not na(t_sl) ? str.tostring(t_sl, "#.#####") : "—", text_color=color.red, text_size=size.small)

    table.cell(tb, 0, 7, "TP1",         text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 7, not na(t_tp1) ? str.tostring(t_tp1, "#.#####") : "—", text_color=color.lime, text_size=size.small)

    table.cell(tb, 0, 8, "TP2",         text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 8, not na(t_tp2) ? str.tostring(t_tp2, "#.#####") : "—", text_color=color.green, text_size=size.small)
