//@version=6
indicator("Nowick — Brad.fx", overlay=true, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════
// NOWICK STRATEGY — Brad.fx
//
// 1. NOWICK CANDLE : quasi-zéro wick côté rejection + corps fort
//    → ce low (bull) ou high (bear) devient un niveau clé
// 2. TREND via BOS : close dépasse le plus haut/bas des 50 dernières barres
// 3. PULLBACK : le nowick se forme pendant un recul dans le trend
// 4. RETEST : prix revient sur le niveau du nowick et tient
//    → la bougie de retest FERME au-dessus (bull) ou en-dessous (bear)
// 5. MAX 1 SIGNAL / JOUR — Session 07-17 UTC
// 6. SL : sous le low du nowick candle — TP : 1:2 RR
// ═══════════════════════════════════════════════════════════════════

// ─── BASE ─────────────────────────────────────────────────────────
atr     = ta.atr(14)
body    = math.abs(close - open)
dn_wick = math.min(open, close) - low
up_wick = high - math.max(open, close)

// ─── NOWICK CANDLE ────────────────────────────────────────────────
// Mèche ≤ 2% du corps + corps ≥ 0.6 ATR (bougie momentum)
bull_nw = close > open and dn_wick <= body * 0.02 and body >= atr * 0.6
bear_nw = close < open and up_wick <= body * 0.02 and body >= atr * 0.6

// ─── TREND via BOS (50 barres) ────────────────────────────────────
bos_hi = ta.highest(high, 50)[1]
bos_lo = ta.lowest(low,   50)[1]

var int   trend   = 0
var float hi_bull = na
var float lo_bear = na

if close > bos_hi
    trend   := 1
    hi_bull := high
else if trend == 1
    hi_bull := math.max(hi_bull, high)

if close < bos_lo
    trend   := -1
    lo_bear := low
else if trend == -1
    lo_bear := math.min(lo_bear, low)

// Nowick valide = dans un pullback du trend confirmé
in_pb_buy  = trend == 1  and not na(hi_bull) and close <= hi_bull - atr * 0.3
in_pb_sell = trend == -1 and not na(lo_bear) and close >= lo_bear  + atr * 0.3

valid_bull = bull_nw and in_pb_buy
valid_bear = bear_nw and in_pb_sell

// ─── STOCKAGE DU NIVEAU ───────────────────────────────────────────
var float nw_buy_lo = na
var int   nw_buy_b  = na
var float nw_sel_hi = na
var int   nw_sel_b  = na

if valid_bull
    nw_buy_lo := low
    nw_buy_b  := bar_index
if valid_bear
    nw_sel_hi := high
    nw_sel_b  := bar_index

age_buy  = na(nw_buy_b) ? na : bar_index - nw_buy_b
age_sell = na(nw_sel_b) ? na : bar_index - nw_sel_b

// Expiration après 12 barres (~3h sur M15)
if not na(age_buy)  and age_buy  > 12 then nw_buy_lo := na, nw_buy_b  := na
if not na(age_sell) and age_sell > 12 then nw_sel_hi := na, nw_sel_b  := na

// Invalidation : close casse le niveau
if not na(nw_buy_lo) and close < nw_buy_lo then nw_buy_lo := na, nw_buy_b := na
if not na(nw_sel_hi) and close > nw_sel_hi then nw_sel_hi := na, nw_sel_b := na

// ─── RETEST ───────────────────────────────────────────────────────
// Le low touche le niveau, la bougie ferme au-dessus (acheteurs défendent)
retest_buy  = not na(nw_buy_lo) and age_buy  >= 1
              and low  <= nw_buy_lo + atr * 0.1
              and close > nw_buy_lo

retest_sell = not na(nw_sel_hi) and age_sell >= 1
              and high >= nw_sel_hi - atr * 0.1
              and close < nw_sel_hi

// ─── SESSION + 1 TRADE / JOUR ─────────────────────────────────────
sess_ok    = hour(time, "UTC") >= 7 and hour(time, "UTC") < 17
var int last_date = 0
cur_date   = year * 10000 + month * 100 + dayofmonth
free_today = cur_date != last_date

buy_sig  = retest_buy  and sess_ok and free_today
sell_sig = retest_sell and sess_ok and free_today

if buy_sig or sell_sig
    last_date := cur_date

// Consommer le niveau après signal
if buy_sig  then nw_buy_lo := na, nw_buy_b := na
if sell_sig then nw_sel_hi := na, nw_sel_b := na

// ─── SL / TP (1:2 RR) ─────────────────────────────────────────────
// SL : juste sous le low du nowick candle (niveau que le marché a défendu)
buy_sl    = buy_sig  ? nw_buy_lo[1] - atr * 0.2 : na
sell_sl   = sell_sig ? nw_sel_hi[1] + atr * 0.2 : na
buy_risk  = not na(buy_sl)  ? close - buy_sl  : na
sell_risk = not na(sell_sl) ? sell_sl - close : na
buy_tp    = not na(buy_risk)  ? close + buy_risk  * 2.0 : na
sell_tp   = not na(sell_risk) ? close - sell_risk * 2.0 : na

// ─── LABELS — TP et SL en prix, pas de lignes ─────────────────────
if buy_sig
    _tp  = str.tostring(buy_tp,  format.mintick)
    _sl  = str.tostring(buy_sl,  format.mintick)
    label.new(bar_index, low,
              "BUY\nTP → " + _tp + "\nSL → " + _sl,
              yloc=yloc.price,
              color=color.new(color.green, 0),
              textcolor=color.white,
              style=label.style_label_up,
              size=size.normal)

if sell_sig
    _tp  = str.tostring(sell_tp, format.mintick)
    _sl  = str.tostring(sell_sl, format.mintick)
    label.new(bar_index, high,
              "SELL\nTP → " + _tp + "\nSL → " + _sl,
              yloc=yloc.price,
              color=color.new(color.red, 0),
              textcolor=color.white,
              style=label.style_label_down,
              size=size.normal)

// ─── PLOT REQUIS TRADINGVIEW ───────────────────────────────────────
plot(na)

// ─── ALERTES ──────────────────────────────────────────────────────
alertcondition(buy_sig,  "Nowick BUY",  "Nowick BUY — retest tenu — 1:2")
alertcondition(sell_sig, "Nowick SELL", "Nowick SELL — retest tenu — 1:2")
